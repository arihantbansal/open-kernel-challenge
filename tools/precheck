def dotted(node):
    """'a.b.c' for Name/Attribute chains, else None."""
    parts = []
    while isinstance(node, ast.Attribute):
        parts.append(node.attr)
        node = node.value
    if isinstance(node, ast.Name):
        parts.append(node.id)
        return ".".join(reversed(parts))
    if isinstance(node, ast.Call):  # torch.cuda.current_stream().synchronize
        inner = dotted(node.func)
        if inner:
            parts.append(inner + "()")
            return ".".join(reversed(parts))
    return None


def const_str(node):
    return node.value if isinstance(node, ast.Constant) and isinstance(node.value, str) else None


class Module:
    """Parsed submission with a name-level call graph over top-level functions."""

    def __init__(self, path: Path):
        self.path = path
        self.src = path.read_text()
        self.tree = ast.parse(self.src, filename=str(path))
        self.lines = self.src.splitlines()
        self.funcs: dict[str, ast.FunctionDef] = {}
        self.classes: dict[str, ast.ClassDef] = {}
        self.consts: dict[str, ast.AST] = {}
        self.module_aliases: dict[str, str] = {}  # local name -> module it names
        self.from_names: dict[str, str] = {}  # local name -> 'pkg.mod.name'
        self.parent: dict[ast.AST, ast.AST] = {}
        for node in ast.walk(self.tree):
            for child in ast.iter_child_nodes(node):
                self.parent[child] = node
        for node in self.tree.body:
            self._index_top(node)
        for node in ast.walk(self.tree):
            if isinstance(node, ast.Import):
                for a in node.names:
                    self.module_aliases[a.asname or a.name.split(".")[0]] = a.name if a.asname else a.name.split(".")[0]
            elif isinstance(node, ast.ImportFrom) and node.module and node.level == 0:
                for a in node.names:
                    self.from_names[a.asname or a.name] = f"{node.module}.{a.name}"
        self.triton_kernels = {n for n, f in self.funcs.items() if self.is_triton(f)}
        self.refs = {n: self._refs(f) for n, f in {**self.funcs, **self.classes}.items()}

    def _index_top(self, node):
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            self.funcs[node.name] = node
        elif isinstance(node, ast.ClassDef):
            self.classes[node.name] = node
        elif isinstance(node, ast.Assign):
            for t in node.targets:
                if isinstance(t, ast.Name):
                    self.consts[t.id] = node.value
        elif isinstance(node, ast.AnnAssign) and isinstance(node.target, ast.Name) and node.value is not None:
            self.consts[node.target.id] = node.value
        elif isinstance(node, (ast.If, ast.Try)):
            for sub in node.body + getattr(node, "orelse", []) + getattr(node, "finalbody", []):
                self._index_top(sub)
            for h in getattr(node, "handlers", []):
                for sub in h.body:
                    self._index_top(sub)

    @staticmethod
    def is_triton(f):
        for d in f.decorator_list:
            name = dotted(d.func if isinstance(d, ast.Call) else d) or ""
            if name.split(".")[-1] in ("jit", "autotune", "heuristics") and "triton" in name or name in ("jit",):
                return True
        return False

    def _refs(self, node):
        names = set()
        for n in ast.walk(node):
            if isinstance(n, ast.Name) and isinstance(n.ctx, ast.Load):
                names.add(n.id)
        return names & (set(self.funcs) | set(self.classes))

    def closure(self, roots):
        seen, todo = set(), [r for r in roots if r in self.refs]
        while todo:
            n = todo.pop()
            if n in seen:
                continue
            seen.add(n)
            if n in self.triton_kernels:
                continue  # device code: no Python-level hazards inside
            todo.extend(self.refs.get(n, ()))
        return seen

    def module_level_refs(self):
        """Functions referenced by top-level statements other than def/class (import-time code)."""
        names = set()
        for node in self.tree.body:
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
                continue
            for n in ast.walk(node):
                if isinstance(n, ast.Name) and isinstance(n.ctx, ast.Load) and n.id in self.funcs:
                    names.add(n.id)
        return names

    def module_level_calls(self):
        """Top-level statements that call module functions at import, with the called names."""
        out = []
        for node in self.tree.body:
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef, ast.Import, ast.ImportFrom)):
                continue
            called = []
            for n in ast.walk(node):
                if isinstance(n, ast.Call):
                    name = dotted(n.func)
                    if name in self.funcs:
                        called.append((name, n.lineno))
            if called:
                out.append((node, called))
        return out

    def enclosing_function(self, node):
        p = self.parent.get(node)
        while p is not None and not isinstance(p, (ast.FunctionDef, ast.AsyncFunctionDef, ast.Lambda)):
            p = self.parent.get(p)
        return p

    def top_function_of(self, node):
        """The top-level function containing node (nested defs resolve to their outer function)."""
        p, top = node, None
        while p is not None:
            if isinstance(p, (ast.FunctionDef, ast.AsyncFunctionDef)) and p.name in self.funcs and self.funcs[p.name] is p:
                top = p
            p = self.parent.get(p)
        return top

    def try_eval(self, node, depth=0):
        """Constant-fold an expression using top-level constants; raises on anything else."""
        if depth > 20:
            raise ValueError("too deep")
        if isinstance(node, ast.Constant):
            return node.value
        if isinstance(node, ast.Name) and node.id in self.consts:
            return self.try_eval(self.consts[node.id], depth + 1)
        if isinstance(node, (ast.List, ast.Tuple)):
            out = []
            for e in node.elts:
                if isinstance(e, ast.Starred):
                    out.extend(self.try_eval(e.value, depth + 1))
                else:
                    out.append(self.try_eval(e, depth + 1))
            return out
        if isinstance(node, ast.BinOp):
            a, b = self.try_eval(node.left, depth + 1), self.try_eval(node.right, depth + 1)
            ops = {ast.Add: lambda: a + b, ast.Sub: lambda: a - b, ast.Mult: lambda: a * b,
                   ast.FloorDiv: lambda: a // b, ast.LShift: lambda: a << b, ast.Pow: lambda: a ** b,
                   ast.Div: lambda: a / b, ast.Mod: lambda: a % b}
            if type(node.op) in ops:
                return ops[type(node.op)]()
        if isinstance(node, ast.UnaryOp) and isinstance(node.op, ast.USub):
            return -self.try_eval(node.operand, depth + 1)
        if isinstance(node, ast.JoinedStr):
            raise ValueError("f-string")
        raise ValueError(f"not constant: {type(node).__name__}")


def call_name(call: ast.Call) -> str:
    return dotted(call.func) or ""


def walk_scope(fn):
    """All nodes of a function including nested functions and lambdas."""
    return ast.walk(fn)


def is_broad_handler(h: ast.ExceptHandler):
    if h.type is None:
        return True
    names = [dotted(e) for e in (h.type.elts if isinstance(h.type, ast.Tuple) else [h.type])]
    return any(n in ("Exception", "BaseException", "RuntimeError", "OSError", "ImportError") for n in names)


def handler_reraises(h: ast.ExceptHandler):
    return any(isinstance(n, ast.Raise) for n in ast.walk(h))


def swallowing_try(mod: Module, node):
    """The innermost enclosing try (within the function) that swallows a broad exception, or None."""
    p, child = mod.parent.get(node), node
    while p is not None and not isinstance(p, (ast.FunctionDef, ast.AsyncFunctionDef, ast.Module)):
        if isinstance(p, ast.Try) and child in p.body:
            for h in p.handlers:
                if is_broad_handler(h) and not handler_reraises(h):
                    return p
        child, p = p, mod.parent.get(p)
    return None


def lint(mod: Module, rep: Report, problem: str | None, scout: Path | None):
    S = "lint"
    first = mod.lines[0] if mod.lines else ""
    m = re.match(r"#\s*okc:\s*problem=(\S+)", first)
    if not m:
        rep.add(S, "ERROR", 1, "header", "first line must be `# okc: problem=<name>`; `okc check/submit` reads the problem from it")
    elif m.group(1) not in PROBLEMS:
        rep.add(S, "ERROR", 1, "header", f"unknown problem {m.group(1)!r} in the first line")
    elif problem and m.group(1) != problem:
        rep.add(S, "ERROR", 1, "header", f"first line names {m.group(1)}, but --problem is {problem}")

    # ---- entry points
    kf = mod.funcs.get("kernel_fn")
    if kf is None:
        rep.add(S, "ERROR", 1, "entry", "no top-level `kernel_fn` defined")
    elif problem:
        nreq = len(kf.args.args) - len(kf.args.defaults)
        want = 1 if problem in NO_WEIGHTS else 2
        if nreq != want and not (kf.args.vararg and nreq <= want):
            rep.add(S, "ERROR", kf.lineno, "entry",
                    f"kernel_fn takes {nreq} required args; {problem} calls kernel_fn({'data' if want == 1 else 'data, state'})")
    if problem and problem not in NO_WEIGHTS and "prepare" not in mod.funcs:
        rep.add(S, "ERROR", 1, "entry", f"{problem} has weights: define prepare(weights) returning the state kernel_fn gets")

    kernel_scope = mod.closure(["kernel_fn"]) - mod.triton_kernels
    prepare_scope = mod.closure(["prepare"]) - mod.triton_kernels - kernel_scope
    import_roots = mod.module_level_refs()
    import_scope = mod.closure(import_roots) - mod.triton_kernels
    rep.details["scopes"] = {"kernel_fn": sorted(kernel_scope), "prepare_only": sorted(prepare_scope),
                             "import_time": sorted(import_scope)}

    # ---- whole-file rules: what the judge rejects
    for node in ast.walk(mod.tree):
        line = getattr(node, "lineno", 0)
        if isinstance(node, (ast.Import, ast.ImportFrom)):
            mods = [a.name for a in node.names] if isinstance(node, ast.Import) else [node.module or ""]
            for name in mods:
                top = name.split(".")[0]
                if top == "reference":
                    rep.add(S, "ERROR", line, "reject.reference", "imports the judge's reference: rejected before running")
                elif top == "checks":
                    rep.add(S, "WARN", line, "harness", "imports checks.py, the judge's harness spec")
                elif top == "baseline":
                    rep.add(S, "WARN", line, "harness", "imports baseline.py; the judge's copy is not guaranteed to be importable")
                elif top in PROCESS_MODULES:
                    rep.add(S, "ERROR", line, "reject.process", f"imports {name}: starting processes is rejected")
                elif top in NETWORK_MODULES:
                    rep.add(S, "ERROR", line, "reject.network", f"imports {name}: network use is rejected")
                elif top in ("ctypes", "cffi"):
                    rep.add(S, "WARN", line, "lowlevel", f"imports {top}: reviewers will read this closely")
                elif top in ("pdb", "ipdb", "code"):
                    rep.add(S, "ERROR", line, "debugger", f"imports {top}")
                elif top in ("atexit", "signal", "threading", "faulthandler"):
                    rep.add(S, "INFO", line, "background", f"imports {top}: work outside the timed calls or harness hooks")
                elif top == "importlib":
                    rep.add(S, "WARN", line, "dynamic-import", "imports importlib (reload or dynamic imports)")
                elif top in PROBLEM_LOCAL:
                    rep.add(S, "INFO", line, "imports", f"imports {top}, which the judge ships beside reference.py")
                elif top and top not in IMAGE_PACKAGES and top not in sys.stdlib_module_names and top != "__future__":
                    rep.add(S, "WARN", line, "imports", f"{top!r} is not a package known to be in the judge image")
        elif isinstance(node, ast.Call):
            name = call_name(node)
            parts = name.split(".")
            if len(parts) >= 2 and parts[-2] == "os" and parts[-1] in OS_PROCESS:
                rep.add(S, "ERROR", line, "reject.process", f"{name}(): starting processes or exiting is rejected")
            elif len(parts) >= 2 and (parts[-2], parts[-1]) in FRAME_CALLS:
                rep.add(S, "ERROR", line, "reject.frames", f"{name}(): reading harness frames/objects is rejected")
            elif name in ("sys.exit", "exit", "quit", "breakpoint"):
                rep.add(S, "ERROR", line, "exit", f"{name}() would end or stall the judge's process")
            elif name in ("exec", "eval", "compile", "__import__"):
                arg = const_str(node.args[0]) if node.args else None
                if name == "__import__" and arg and arg.split(".")[0] == "reference":
                    rep.add(S, "ERROR", line, "reject.reference", "__import__('reference')")
                else:
                    rep.add(S, "WARN", line, "dynamic-code", f"{name}() of dynamic code: reviewers will read this closely")
            elif name in ("importlib.import_module", "importlib.reload"):
                arg = const_str(node.args[0]) if node.args else None
                sev = "ERROR" if arg and arg.split(".")[0] == "reference" else "WARN"
                rep.add(S, sev, line, "dynamic-import", f"{name}({arg or '...'})")
            elif name == "setattr" and node.args:
                root = (dotted(node.args[0]) or "").split(".")[0]
                if root in mod.module_aliases:
                    rep.add(S, "ERROR", line, "reject.monkeypatch", f"setattr on module {dotted(node.args[0])}: editing loaded modules is rejected")
            elif name in ("os.environ.get", "os.getenv", "os.environ.setdefault", "os.environ.__getitem__"):
                key = const_str(node.args[0]) if node.args else None
                if key and SECRET_RE.search(key):
                    rep.add(S, "ERROR", line, "reject.secrets", f"reads environment variable {key}: touching secrets is rejected")
                elif name == "os.environ.setdefault":
                    rep.add(S, "WARN", line, "env", f"sets {key} in the judge's environment")
                else:
                    default = ast.unparse(node.args[1]) if len(node.args) > 1 else "None"
                    rep.add(S, "WARN", line, "mode.env",
                            f"behaviour depends on env var {key} (default {default}); the judge does not set it, so the default runs")
            elif name in ("os.environ.items", "os.environ.keys", "os.environ.values", "os.environ.copy") or \
                    (name == "dict" and node.args and dotted(node.args[0]) == "os.environ"):
                rep.add(S, "ERROR", line, "reject.secrets", "reads the whole environment (secrets)")
            elif name == "os.putenv":
                rep.add(S, "WARN", line, "env", "os.putenv changes the judge's environment")
            elif len(parts) >= 2 and parts[-2] == "os" and parts[-1] in OS_FILE_MUTATE:
                rep.add(S, "WARN", line, "harness.io", f"{name}(): file-system mutation; touching harness files is rejected")
            elif parts[0] == "shutil":
                rep.add(S, "WARN", line, "harness.io", f"{name}(): file-system mutation")
            elif name == "open" or name.endswith(".write_text") or name.endswith(".write_bytes"):
                mode = const_str(node.args[1]) if len(node.args) > 1 else None
                for kw in node.keywords:
                    if kw.arg == "mode":
                        mode = const_str(kw.value)
                target = ast.unparse(node.args[0]) if node.args else ""
                writes = name != "open" or (mode and any(c in mode for c in "wax+"))
                harnessy = re.search(r"reference|checks|judge|harness|__file__|stdout|stderr|/proc|\.py", target)
                if writes and harnessy:
                    rep.add(S, "ERROR", line, "reject.harness-io", f"writes {target}: touching harness files is rejected")
                elif writes:
                    rep.add(S, "WARN", line, "harness.io", f"writes a file ({target}); keep file I/O out of submissions")
                else:
                    rep.add(S, "WARN", line, "harness.io", f"reads a file at runtime ({target})")
            elif name in ("atexit.register", "threading.Thread", "signal.signal"):
                top = mod.top_function_of(node)
                if name == "threading.Thread" and top is not None and top.name in mod.closure(["prepare"]):
                    rep.add(S, "INFO", line, "background", f"{name}() in prepare (parallel work inside prepare's 300 s)")
                else:
                    rep.add(S, "WARN", line, "background", f"{name}(): work or hooks outside the timed calls")
        elif isinstance(node, ast.Attribute) and node.attr in FRAME_ATTRS:
            rep.add(S, "ERROR", line, "reject.frames", f".{node.attr}: reading frames is rejected")
        elif isinstance(node, (ast.Assign, ast.AugAssign, ast.AnnAssign, ast.Delete)):
            targets = node.targets if isinstance(node, (ast.Assign, ast.Delete)) else [node.target]
            for t in targets:
                base = t.value if isinstance(t, ast.Subscript) else t
                full = dotted(base) or ""
                root = full.split(".")[0]
                if isinstance(t, ast.Subscript) and full == "os.environ":
                    key = const_str(t.slice)
                    rep.add(S, "WARN", line, "env", f"sets os.environ[{key!r}] in the judge's process")
                elif isinstance(t, ast.Subscript) and full == "sys.modules":
                    rep.add(S, "ERROR", line, "reject.monkeypatch", "assigns into sys.modules: editing loaded modules is rejected")
                elif isinstance(t, ast.Attribute) and root in mod.module_aliases:
                    if re.match(r"(torch\.backends|torch\._dynamo\.config|torch\._inductor\.config|triton\.knobs)", full):
                        rep.add(S, "WARN", line, "global-setting",
                                f"sets {full}: a process-wide setting that also changes SGLang's timed baseline")
                    elif full in ("sys.stdout", "sys.stderr", "sys.stdin"):
                        rep.add(S, "ERROR", line, "reject.harness-io", f"replaces {full}: touching harness I/O is rejected")
                    else:
                        rep.add(S, "ERROR", line, "reject.monkeypatch",
                                f"assigns {full}: editing loaded modules (timing, CUDA events, torch) is rejected")
        elif isinstance(node, ast.Constant) and isinstance(node.value, str) and len(node.value) < 300:
            if re.match(r"(/Users/|/home/|~/|/private/|C:\\)", node.value):
                rep.add(S, "WARN", line, "local-path", f"hard-coded local path {node.value!r}")

    # ---- CUDA-graph hazards, strict inside kernel_fn and what it calls
    kernel_params = set()
    if kf is not None:
        kernel_params = {a.arg for a in kf.args.args}
    for fname in sorted(kernel_scope):
        fnode = mod.funcs.get(fname) or mod.classes.get(fname)
        _graph_hazards(mod, rep, fnode, fname, kernel_params)

    # ---- import-time work and leftovers
    for node, called in mod.module_level_calls():
        names = [c[0] for c in called]
        line = node.lineno
        reach = mod.closure(names) - mod.triton_kernels
        diag = sorted(n for n in reach if DIAG_NAME_RE.search(n))
        timing = sorted(n for n in reach if _has_timing(mod.funcs.get(n)))
        if diag or timing:
            rep.add(S, "WARN", line, "leftover.import-time",
                    f"import runs {', '.join(names)} -> {', '.join(sorted(set(diag + timing)))}: diagnostic/benchmark code "
                    "executes on the judge before any timed call (fine for a check run, remove before submitting)")
        else:
            rep.add(S, "INFO", line, "import-time", f"import-time call: {', '.join(names)}")
    for node in mod.tree.body:
        if isinstance(node, ast.Expr) and isinstance(node.value, ast.Call) and call_name(node.value) == "print":
            rep.add(S, "INFO", node.lineno, "import-time", "prints at import")
        for n in ast.walk(node) if not isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)) else ():
            if isinstance(n, ast.Call) and call_name(n).split(".")[-1] in ("empty", "zeros", "ones", "randn", "rand", "full", "arange", "empty_like") \
                    and call_name(n).startswith("torch"):
                size = _alloc_bytes(mod, n)
                dev = next((ast.unparse(k.value) for k in n.keywords if k.arg == "device"), "cpu")
                if "cuda" in dev or dev not in ("cpu", "'cpu'"):
                    sev = "WARN" if size is None or size > (64 << 20) else "INFO"
                    sz = f"{size / 2**20:.1f} MiB" if size is not None else "size not constant"
                    rep.add(S, sev, n.lineno, "import-alloc", f"module-level GPU allocation ({sz}) at import, outside prepare()")
        if isinstance(node, ast.If) and isinstance(node.test, ast.Compare) and dotted(node.test.left) == "__name__":
            rep.add(S, "INFO", node.lineno, "leftover", "`if __name__ == '__main__'` block (never runs on the judge)")

    # mode flags
    for name, value in mod.consts.items():
        if MODE_FLAG_RE.search(name) and isinstance(value, ast.Constant) and len(str(value.value)) < 40:
            node = next(n for n in mod.tree.body if isinstance(n, (ast.Assign, ast.AnnAssign)) and
                        any(isinstance(t, ast.Name) and t.id == name for t in (n.targets if isinstance(n, ast.Assign) else [n.target])))
            rep.add(S, "WARN" if value.value not in (False, None, 0, "") else "INFO", node.lineno, "leftover.mode",
                    f"mode flag {name} = {value.value!r}")

    # dead code / unused sources
    used = set()
    for n in ast.walk(mod.tree):
        if isinstance(n, ast.Name) and isinstance(n.ctx, ast.Load):
            used.add(n.id)
    entry = {"kernel_fn", "prepare"}
    for name, f in mod.funcs.items():
        if name not in used and name not in entry:
            sev = "WARN" if DIAG_NAME_RE.search(name) else "INFO"
            rep.add(S, sev, f.lineno, "leftover.dead", f"function {name} is never referenced")
    for name, f in mod.funcs.items():
        if name in used and DIAG_NAME_RE.search(name) and name not in kernel_scope | prepare_scope | import_scope:
            rep.add(S, "INFO", f.lineno, "leftover.dead", f"{name} is only reachable from other unused code")
    for name, value in mod.consts.items():
        s = const_str(value)
        if s and len(s) > 2000 and name not in used:
            rep.add(S, "WARN", value.lineno, "leftover.dead", f"source string {name} ({len(s.splitlines())} lines) is never used")

    # ---- builds
    builds = _build_sites(mod)
    rep.details["build_sites"] = [{"line": b["line"], "func": b["func"], "flags": b.get("cuda_flags"),
                                   "cflags": b.get("cflags"), "name": b.get("name")} for b in builds]
    for b in builds:
        flags = (b.get("cuda_flags") or []) + (b.get("cflags") or [])
        for fl in flags:
            mm = re.match(r"-std=(?:c|gnu)\+\+(\d+)", str(fl))
            if mm and int(mm.group(1)) < 20 and int(mm.group(1)) > 3:
                rep.add(S, "ERROR", b["line"], "build.std",
                        f"{b['call']}({b.get('name') or ''!r}) passes {fl}: torch 2.14's ATen headers need C++20, so this build fails "
                        "on the judge" + (" and the file silently falls back" if b.get("swallowed") else ""))
        if b.get("cuda_flags") is not None and not any(str(f).startswith(("-gencode", "-arch", "--gpu-architecture", "-code"))
                                                       for f in b["cuda_flags"]):
            rep.add(S, "WARN", b["line"], "build.arch",
                    "no -gencode/-arch flag: torch builds for the visible GPU (sm_90 + compute_90 PTX), so sm_90a-only "
                    "features (wgmma, setmaxnreg, TMA multicast) won't compile; pass -gencode=arch=compute_90a,code=sm_90a")
        if b.get("cuda_flags") is None and b.get("unresolved"):
            rep.add(S, "INFO", b["line"], "build.flags", f"flags not statically resolvable: {b['unresolved']}")
        if b.get("swallowed"):
            t = b["swallowed"]
            rep.add(S, "WARN", b["line"], "build.swallowed",
                    f"a failure of this build is caught at line {t} and not re-raised: the file silently falls back to "
                    "another path. The build stage below checks it compiles.")
        if b.get("verbose"):
            rep.add(S, "INFO", b["line"], "build.verbose", "verbose=True build output lands in the run log")
        if b["func"] in kernel_scope:
            rep.add(S, "WARN", b["line"], "build.in-kernel",
                    f"{b['call']} is reachable from kernel_fn ({b['func']}); make sure it is cached and runs before capture")
        where = "prepare()" if b["func"] in prepare_scope else ("import" if b["func"] in import_scope or b["func"] is None
                                                                else "kernel_fn" if b["func"] in kernel_scope else "unreached")
        b["where"] = where
        if where == "unreached":
            rep.add(S, "WARN", b["line"], "build.unreached", f"{b['call']} in {b['func']} is not reachable from import, prepare or kernel_fn")

    # ---- prepare budget heuristics
    if "prepare" in mod.funcs:
        pscope = mod.closure(["prepare"]) - mod.triton_kernels
        budgets = []
        for fname in pscope:
            f = mod.funcs.get(fname)
            if f is None:
                continue
            for n in ast.walk(f):
                if isinstance(n, ast.Compare) and len(n.comparators) == 1:
                    sides = [n.left, n.comparators[0]]
                    texts = [ast.unparse(s) for s in sides]
                    if any(re.search(r"time\.(time|perf_counter|monotonic)\(\)", t) for t in texts):
                        for s in sides:
                            try:
                                v = mod.try_eval(s)
                                if isinstance(v, (int, float)) and 10 <= v <= 3600:
                                    budgets.append((v, n.lineno, fname))
                            except Exception:
                                pass
        tuning = sorted(n for n in pscope if _has_timing(mod.funcs.get(n)))
        rep.details["prepare"] = {"budgets": budgets, "timing_funcs": tuning,
                                  "builds_in_prepare": [b["line"] for b in builds if b.get("where") == "prepare()"]}
        if budgets:
            hi = max(budgets)
            sev = "WARN" if hi[0] > 240 else "INFO"
            rep.add(S, sev, hi[1], "prepare.budget",
                    f"prepare's wall-clock guard tops out at {hi[0]:g} s (in {hi[2]}); the limit is {PREPARE_LIMIT_S} s and "
                    "work after the last guard check (and the build, if it is in prepare) still counts")
        elif tuning:
            rep.add(S, "WARN", mod.funcs["prepare"].lineno, "prepare.budget",
                    f"prepare times things ({', '.join(tuning)}) but has no wall-clock guard; it must finish in {PREPARE_LIMIT_S} s")

    # ---- imports resolve against the image's sources (scout clones)
    if scout and scout.is_dir():
        _check_imports(mod, rep, scout)


def _has_timing(f):
    if f is None:
        return False
    for n in ast.walk(f):
        if isinstance(n, ast.Call):
            name = call_name(n)
            last = name.split(".")[-1]
            if last in ("CUDAGraph", "do_bench", "do_bench_cudagraph", "elapsed_time") or \
                    (last == "Event" and any(k.arg == "enable_timing" for k in n.keywords)):
                return True
    return False


def _alloc_bytes(mod, call):
    sizes = {"float32": 4, "float": 4, "int32": 4, "bfloat16": 2, "float16": 2, "half": 2, "int64": 8, "long": 8,
             "uint8": 1, "int8": 1, "float8_e4m3fn": 1, "int": 8, "bool": 1}
    try:
        shape = mod.try_eval(call.args[0]) if call.args else None
        if isinstance(shape, int):
            numel = shape
        else:
            numel = 1
            for s in shape:
                numel *= s
        dt = next((k.value for k in call.keywords if k.arg == "dtype"), None)
        esz = sizes.get(dt.attr if isinstance(dt, ast.Attribute) else "float32", 4)
        return numel * esz
    except Exception:
        return None


def _graph_hazards(mod, rep, fnode, fname, kernel_params):
    S = "lint"
    if fnode is None:
        return
    ctx = f"in {fname} (reached from kernel_fn)" if fname != "kernel_fn" else "in kernel_fn"
    # a cached builder (contains load_inline) prints/times its own one-off build: not a per-call hazard
    builder = any(isinstance(c, ast.Call) and call_name(c).split(".")[-1] in BUILD_FUNCS for c in ast.walk(fnode))
    mask_names = set()
    for n in ast.walk(fnode):
        if isinstance(n, ast.Assign) and len(n.targets) == 1 and isinstance(n.targets[0], ast.Name):
            v = n.value
            if isinstance(v, ast.Compare) or (isinstance(v, ast.Call) and call_name(v).split(".")[-1] in
                                              ("bool", "isfinite", "isnan", "isinf", "logical_and", "logical_or", "logical_not",
                                               "eq", "ne", "gt", "lt", "ge", "le")) or \
                    (isinstance(v, ast.UnaryOp) and isinstance(v.op, ast.Invert)):
                mask_names.add(n.targets[0].id)
    for n in ast.walk(fnode):
        line = getattr(n, "lineno", fnode.lineno)
        if isinstance(n, ast.Call):
            name = call_name(n)
            last = name.split(".")[-1]
            if isinstance(n.func, ast.Attribute) and last in SYNC_METHODS and not name.startswith(("tl.", "triton.")):
                rep.add(S, "ERROR", line, "graph.sync", f".{last}() {ctx}: {SYNC_METHODS[last]}, breaks CUDA-graph capture")
            elif last == "synchronize":
                rep.add(S, "ERROR", line, "graph.sync", f"{name}() {ctx}: host sync, breaks CUDA-graph capture")
            elif last == "to" and any((const_str(a) or "").startswith("cpu") for a in n.args) or \
                    last == "to" and any(k.arg == "device" and "cpu" in ast.unparse(k.value) for k in n.keywords):
                rep.add(S, "ERROR", line, "graph.sync", f"{name}('cpu') {ctx}: device-to-host copy")
            elif last in VALUE_SHAPE_FUNCS and (name.startswith("torch.") or isinstance(n.func, ast.Attribute)) \
                    and not name.startswith(("tl.", "triton.")):
                rep.add(S, "ERROR", line, "graph.value-shape",
                        f"{name}() {ctx}: output shape depends on values (host sync; not capturable)")
            elif name == "torch.where" and len(n.args) == 1:
                rep.add(S, "ERROR", line, "graph.value-shape", f"torch.where(cond) {ctx}: value-dependent shape")
            elif last == "repeat_interleave" and not any(k.arg == "output_size" for k in n.keywords):
                rep.add(S, "WARN", line, "graph.value-shape",
                        f"{name}() {ctx} without output_size syncs when repeats is a tensor")
            elif last == "bincount":
                rep.add(S, "WARN", line, "graph.value-shape", f"{name}() {ctx}: output size depends on values")
            elif name == "print" and not builder:
                rep.add(S, "WARN", line, "graph.print",
                        f"print() {ctx}: runs on every eager call, and printing a tensor value syncs")
            elif name in ("int", "float", "bool") and n.args and _mentions_reduction(n.args[0]):
                rep.add(S, "ERROR", line, "graph.sync", f"{name}({ast.unparse(n.args[0])[:60]}) {ctx}: tensor-to-Python conversion syncs")
            elif name in ("torch.tensor", "torch.as_tensor", "torch.from_numpy") or last in ("cuda", "pin_memory") and \
                    isinstance(n.func, ast.Attribute) and not name.startswith("torch.cuda"):
                rep.add(S, "WARN", line, "graph.h2d",
                        f"{name}() {ctx}: host-to-device copy; fails under capture from pageable memory and freezes the value into the graph")
            elif name.startswith("torch.cuda.") and last in ("empty_cache", "set_device", "memory_allocated", "reset_peak_memory_stats",
                                                               "max_memory_allocated", "ipc_collect"):
                rep.add(S, "WARN", line, "graph.misc", f"{name}() {ctx}")
            elif last in ("CUDAGraph", "graph", "Event", "elapsed_time", "do_bench") and ("cuda" in name or "triton" in name):
                rep.add(S, "WARN", line, "leftover.timing", f"{name}() {ctx}: timing/graph code in the timed path")
            elif name in ("time.time", "time.perf_counter", "time.sleep", "time.monotonic") and not builder:
                rep.add(S, "WARN", line, "leftover.timing", f"{name}() {ctx}: has no effect under graph replay; diagnostic leftover?")
            elif name in ("torch.manual_seed", "torch.randn", "torch.rand", "torch.randint", "torch.randperm"):
                rep.add(S, "WARN", line, "graph.rng", f"{name}() {ctx}: randomness in the timed path")
            elif name == "torch.compile":
                rep.add(S, "WARN", line, "graph.compile", f"torch.compile {ctx}")
            elif last in ("nonzero_static",):
                pass
        elif isinstance(n, ast.Subscript) and isinstance(n.ctx, (ast.Load, ast.Store)):
            sl = n.slice
            if isinstance(sl, ast.Compare) or (isinstance(sl, ast.Name) and sl.id in mask_names) or \
                    (isinstance(sl, ast.UnaryOp) and isinstance(sl.op, ast.Invert)):
                rep.add(S, "ERROR", line, "graph.value-shape",
                        f"boolean-mask indexing {ast.unparse(n)[:60]} {ctx}: value-dependent shape (use torch.where)")
        elif isinstance(n, (ast.If, ast.While, ast.Assert, ast.IfExp)):
            test = n.test
            if _mentions_reduction(test, strict=True):
                rep.add(S, "ERROR", line, "graph.sync",
                        f"control flow on a tensor value ({ast.unparse(test)[:60]}) {ctx}: host sync, not capturable")
            elif isinstance(n, ast.Assert):
                rep.add(S, "WARN", line, "shape.assert",
                        f"assert {ast.unparse(test)[:70]} {ctx}: a nearby or test shape that fails it crashes the run")
        elif isinstance(n, ast.Global):
            rep.add(S, "INFO", line, "graph.state", f"global {', '.join(n.names)} {ctx}: module state mutated from the timed path")
        if isinstance(n, ast.Assign):
            for t in n.targets:
                if isinstance(t, ast.Subscript) and isinstance(t.value, ast.Name) and t.value.id in mod.consts:
                    src = ast.unparse(n.value)
                    uses_data = any(re.search(rf"\b{re.escape(p)}\[(?!['\"]config)", src) for p in kernel_params) if kernel_params else False
                    if uses_data:
                        rep.add(S, "WARN", line, "fresh-inputs",
                                f"caches into module-level {t.value.id} from the inputs {ctx}: every call gets fresh inputs")
                    else:
                        rep.add(S, "INFO", line, "graph.state",
                                f"fills module-level cache {t.value.id} {ctx}; fine if keyed on shapes/config and filled before capture")


def _mentions_reduction(node, strict=False):
    for n in ast.walk(node):
        if isinstance(n, ast.Call) and isinstance(n.func, ast.Attribute):
            if n.func.attr in (("any", "all", "item") if strict else REDUCERS):
                base = dotted(n.func.value) or ""
                if base.split(".")[0] in ("np", "numpy", "math", "builtins", "os", "re"):
                    continue
                return True
    return False


def _build_sites(mod: Module):
    """Every load_inline / cpp_extension.load call with statically resolved flags where possible."""
    out = []
    for n in ast.walk(mod.tree):
        if not isinstance(n, ast.Call):
            continue
        name = call_name(n)
        last = name.split(".")[-1]
        resolved = mod.from_names.get(name, name)
        if last not in BUILD_FUNCS or ("cpp_extension" not in resolved and "cpp_extension" not in name):
            if not (last == "load_inline"):
                continue
        site = {"line": n.lineno, "call": last, "func": None, "unresolved": []}
        if n.args:
            try:
                site["name"] = mod.try_eval(n.args[0])
            except Exception:
                pass
        top = mod.top_function_of(n)
        site["func"] = top.name if top else None
        for kw in n.keywords:
            key = {"extra_cuda_cflags": "cuda_flags", "extra_cflags": "cflags", "name": "name", "verbose": "verbose",
                   "extra_ldflags": "ldflags", "extra_include_paths": "includes"}.get(kw.arg)
            if not key:
                continue
            try:
                site[key] = mod.try_eval(kw.value)
            except Exception:
                site["unresolved"].append(f"{kw.arg}={ast.unparse(kw.value)[:80]}")
        t = swallowing_try(mod, n)
        if t is None and top is not None:  # one or two call levels up
            frontier = [top.name]
            for _ in range(3):
                nxt = []
                for callee in frontier:
                    for f in mod.funcs.values():
                        for c in ast.walk(f):
                            if isinstance(c, ast.Call) and call_name(c) == callee:
                                tt = swallowing_try(mod, c)
                                if tt is not None:
                                    t = t or tt
                                nxt.append(f.name)
                    for c in ast.walk(mod.tree):  # module level
                        if isinstance(c, ast.Call) and call_name(c) == callee and mod.top_function_of(c) is None:
                            tt = swallowing_try(mod, c)
                            if tt is not None:
                                t = t or tt
                if t is not None:
                    break
                frontier = nxt
        site["swallowed"] = t.lineno if t is not None else None
        out.append(site)
    return out


def _check_imports(mod: Module, rep: Report, scout: Path):
    cache: dict[Path, set | None] = {}

    def defined(path: Path):
        if path not in cache:
            try:
                tree = ast.parse(path.read_text())
            except Exception:
                cache[path] = None
                return None
            names = set()
            for node in ast.walk(tree):
                if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
                    names.add(node.name)
                elif isinstance(node, ast.Assign):
                    for t in node.targets:
                        for e in ast.walk(t):
                            if isinstance(e, ast.Name):
                                names.add(e.id)
                elif isinstance(node, (ast.AnnAssign, ast.AugAssign)) and isinstance(node.target, ast.Name):
                    names.add(node.target.id)
                elif isinstance(node, (ast.Import, ast.ImportFrom)):
                    for a in node.names:
                        if a.name == "*":
                            names.add("*")
                        names.add(a.asname or a.name.split(".")[0])
            cache[path] = names
        return cache[path]

    def locate(modname):
        top = modname.split(".")[0]
        if top not in SCOUT_ROOTS:
            return None, None
        root, sev = SCOUT_ROOTS[top]
        base = scout / root
        if not (base / top).is_dir():
            return None, None
        p = base.joinpath(*modname.split("."))
        for cand in (p.with_suffix(".py"), p / "__init__.py"):
            if cand.is_file():
                return cand, sev
        if p.is_dir():
            return p, sev  # namespace package
        return False, sev

    seen = set()
    for node in ast.walk(mod.tree):
        if isinstance(node, ast.ImportFrom) and node.module and node.level == 0:
            path, sev = locate(node.module)
            if path is None:
                continue
            if path is False:
                key = (node.module, None)
                if key not in seen:
                    seen.add(key)
                    rep.add("lint", sev, node.lineno, "imports.resolve", f"module {node.module} not found in the image's source")
                continue
            for a in node.names:
                if path.is_dir():
                    if not (path / f"{a.name}.py").exists() and not (path / a.name).is_dir():
                        rep.add("lint", sev, node.lineno, "imports.resolve", f"{node.module}.{a.name} not found in the image's source")
                    continue
                names = defined(path)
                if names is None or "*" in names or "__getattr__" in names:
                    continue
                if a.name not in names and not (path.parent / f"{a.name}.py").exists() and not (path.parent / a.name).is_dir():
                    rep.add("lint", sev, node.lineno, "imports.resolve",
                            f"{a.name} is not defined in {node.module} ({path.relative_to(scout)})")
        elif isinstance(node, ast.Import):
            for a in node.names:
                path, sev = locate(a.name)
                if path is False:
                    rep.add("lint", sev, node.lineno, "imports.resolve", f"module {a.name} not found in the image's source")


