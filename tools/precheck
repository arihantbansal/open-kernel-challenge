def _constexpr_summary(jit, args, kwargs):
    try:
        names = jit.arg_names
        cidx = [p.num for p in jit.params if p.is_constexpr]
        vals = {}
        for i in cidx:
            n = names[i]
            if i < len(args):
                vals[n] = args[i]
            elif n in kwargs:
                vals[n] = kwargs[n]
        for k in ("num_warps", "num_stages", "num_ctas", "maxnreg"):
            if k in kwargs:
                vals[k] = kwargs[k]
        return {k: (v if isinstance(v, (int, float, bool, str, type(None))) else str(v)) for k, v in vals.items()}
    except Exception as e:
        return {"?": str(e)[:100]}


def ptxas_usage(ptx: str, workdir: Path, name: str):
    """Registers / spills / static smem of one Triton kernel, from ptxas -v on its PTX."""
    import triton.backends.nvidia.compiler as nvc
    try:
        ptxas = nvc.get_ptxas(90).path
    except Exception:
        ptxas = "/usr/local/cuda/bin/ptxas"
    f = workdir / f"{name}.ptx"
    f.write_text(ptx)
    r = subprocess.run([ptxas, "-v", "--gpu-name", "sm_90a", "-O3", str(f), "-o", str(f.with_suffix(".cubin"))],
                       capture_output=True, text=True)
    return parse_ptxas(r.stdout + r.stderr), ptxas_diagnostics(r.stdout + r.stderr)


def parse_ptxas(text: str):
    """{mangled: {regs, spill_st, spill_ld, stack, smem, cmem}} from ptxas -v output."""
    res, cur = {}, None
    for line in text.splitlines():
        m = re.search(r"(?:Compiling entry function|Function properties for) '?([\w$]+)'?", line)
        if m:
            cur = m.group(1)
            res.setdefault(cur, {})
            continue
        if cur is None:
            continue
        m = re.search(r"(\d+) bytes stack frame, (\d+) bytes spill stores, (\d+) bytes spill loads", line)
        if m:
            res[cur].update(stack=int(m.group(1)), spill_st=int(m.group(2)), spill_ld=int(m.group(3)))
        m = re.search(r"Used (\d+) registers", line)
        if m:
            res[cur]["regs"] = int(m.group(1))
            sm = re.search(r"(\d+) bytes smem", line)
            res[cur]["smem"] = int(sm.group(1)) if sm else 0
    return {k: v for k, v in res.items() if "regs" in v}


# C7510-C7519 is ptxas's wgmma serialization family ("wgmma.mma_async instructions are serialized due to ...").
# ptxas prints them as `ptxas info` lines, so a plain warning filter drops them.
PTXAS_DIAG_RE = re.compile(r"\(?C751\d\)?|spill", re.I)


def ptxas_diagnostics(text: str):
    """[{kernel, code, text}] for ptxas lines about wgmma serialization (C751x) or non-zero spills."""
    res, cur, seen = [], None, set()
    for line in text.splitlines():
        m = re.search(r"(?:Compiling entry function|Function properties for) '?([\w$]+)'?", line)
        if m:
            cur = m.group(1)
        if "ptxas" not in line and not re.search(r"[1-9]\d* bytes spill", line):
            continue  # "0 bytes spill stores" lines and nvcc/host noise
        if not PTXAS_DIAG_RE.search(line) or re.search(r"\b0 bytes spill stores, 0 bytes spill loads", line):
            continue
        code = re.search(r"C751\d", line)
        named = re.search(r"function '?([\w$]+)'?", line.split(":", 1)[-1])
        kernel = named.group(1) if named and named.group(1).startswith("_Z") else cur
        key = (kernel, line.strip())
        if key not in seen:
            seen.add(key)
            res.append({"kernel": kernel, "code": code.group(0) if code else "spill", "text": line.strip()[:400]})
    return res


def dump_sass(so_paths, pattern: str, outdir: Path, names: dict):
    """cuobjdump -sass the built .so files; write each kernel whose mangled or demangled name matches into
    outdir/<kernel>.sass. Returns [{kernel, mangled, path}]."""
    rx, written = re.compile(pattern), []
    outdir.mkdir(exist_ok=True)
    for so in so_paths:
        r = subprocess.run(["/usr/local/cuda/bin/cuobjdump", "-sass", str(so)], capture_output=True, text=True)
        parts = re.split(r"^\s*Function : (\S+)\s*$", r.stdout, flags=re.M)
        funcs = dict(zip(parts[1::2], parts[2::2]))
        dem = {**demangle([n for n in funcs if n not in names]), **names}
        for mangled, body in funcs.items():
            pretty = re.sub(r"^void ", "", dem.get(mangled, mangled))
            short = _short_kernel(pretty, 200)  # as the report's ptxas table prints it
            if not (rx.search(mangled) or rx.search(pretty) or rx.search(short)):
                continue
            stem =re.sub(r"_+", "_", re.sub(r"[^\w.-]", "_", short)).strip("_")[:120] or mangled[:120]
            path = outdir / f"{stem}.sass"
            i = 2
            while path.exists():
                path, i = outdir / f"{stem}_{i}.sass", i + 1
            path.write_text(f"// {pretty}\n// {mangled}\n// from cuobjdump -sass {so.name}\nFunction : {mangled}\n{body}")
            written.append({"kernel": short, "mangled": mangled, "path": str(path)})
    return written


def demangle(names):
    if not names:
        return {}
    try:
        r = subprocess.run(["/usr/local/cuda/bin/cu++filt"], input="\n".join(names), capture_output=True, text=True)
        out = r.stdout.splitlines()
        if len(out) == len(names):
            return dict(zip(names, out))
    except Exception:
        pass
    return {n: n for n in names}


def install_build_recorder(torch, out, stub_ext, sass_re=None):
    """Wrap load_inline / load: really build (flags untouched, plus -Xptxas -v), record the
    result and the exact nvcc lines, and hand back a module whose functions only record calls."""
    import hashlib
    import threading
    import torch.utils.cpp_extension as ce

    lock = threading.Lock()
    local = threading.local()
    real_sub_run = subprocess.run

    def sub_run(*a, **k):
        r = real_sub_run(*a, **k)
        if getattr(local, "capture", None) is not None and isinstance(getattr(r, "stdout", None), (bytes, str)):
            local.capture.append(r.stdout.decode(errors="replace") if isinstance(r.stdout, bytes) else r.stdout)
        return r

    subprocess.run = sub_run
    ce.subprocess.run = sub_run
    real_inline, real_load = ce.load_inline, ce.load
    done = {}

    def wrap(real, kind):
        def recorder(*args, **kwargs):
            line = Trace.site()
            sig = repr((kind, args, sorted(kwargs.items())))
            key = hashlib.sha1(sig.encode()).hexdigest()[:12]
            with lock:  # one nvcc at a time: parallel builds in threads blow the container's memory cap
                return _build(args, kwargs, key, line)

        def _build(args, kwargs, key, line):
            if key in done:
                rec = done[key]
                rec["calls"].append(line)
                if rec["ok"]:
                    return rec["_module"]
                raise RuntimeError(rec["error"][-2000:])
            name = kwargs.get("name", args[0] if args else "?")
            k2 = dict(kwargs)
            flags = list(k2.get("extra_cuda_cflags") or [])
            k2["extra_cuda_cflags"] = flags + ["-Xptxas=-v"]
            k2["verbose"] = False
            build_dir = k2.get("build_directory") or ce._get_build_directory(name, False)
            rec = {"name": name, "kind": kind, "line": line, "calls": [line], "in_kernel": Trace.in_kernel,
                   "flags_cuda": flags, "flags_c": list(k2.get("extra_cflags") or []), "build_dir": str(build_dir)}
            done[key] = rec
            out["builds"].append(rec)
            print(f"[precheck] building {kind} {name!r} (line {line}) ...", file=sys.__stdout__, flush=True)
            local.capture = []
            t0 = time.time()
            try:
                module = real(*args, **k2)
                rec["ok"] = True
            except BaseException as e:
                rec["ok"] = False
                rec["error"] = "\n".join(local.capture)[-6000:] + f"\n{type(e).__name__}: {str(e)[-3000:]}"
                raise
            finally:
                rec["seconds"] = round(time.time() - t0, 1)
                log = "\n".join(local.capture)
                local.capture = None
                rec["ptxas"] = parse_ptxas(log)
                rec["ptxas_diag"] = ptxas_diagnostics(log)
                rec["ptxas_names"] = demangle(sorted(set(rec["ptxas"]) | {d["kernel"] for d in rec["ptxas_diag"] if d["kernel"]}))
                if sass_re and rec.get("ok"):
                    try:
                        sos = sorted(Path(build_dir).glob("*.so"), key=lambda p: p.stat().st_mtime)[-1:]
                        rec["sass"] = dump_sass(sos, sass_re, Path(out["stage"]) / "sass", rec["ptxas_names"])
                    except Exception as e:  # noqa: BLE001
                        rec["sass_error"] = f"{type(e).__name__}: {str(e)[:300]}"
                rec["warnings"] = sorted({l.strip()[:300] for l in log.splitlines()
                                          if re.search(r"warning", l, re.I) and "ptxas info" not in l})[:30]
                try:
                    ninja = Path(build_dir, "build.ninja").read_text()
                    rec["ninja_cuda_flags"] = (re.search(r"^cuda_cflags = (.*)$", ninja, re.M) or [None, ""])[1]
                    rec["ninja_post_cflags"] = (re.search(r"^cuda_post_cflags = (.*)$", ninja, re.M) or [None, ""])[1]
                    rec["ninja_cflags"] = (re.search(r"^cflags = (.*)$", ninja, re.M) or [None, ""])[1]
                except OSError:
                    pass
                print(f"[precheck]   {'ok' if rec.get('ok') else 'FAILED'} in {rec['seconds']} s", file=sys.__stdout__, flush=True)
            rec["_module"] = stub_ext(module, name)
            return rec["_module"]
        return recorder

    ce.load_inline = wrap(real_inline, "load_inline")
    ce.load = wrap(real_load, "load")


def make_ext_stub(out):
    def stub_ext(module, ext_name):
        class Ext:
            def __getattr__(self, attr):
                fn = getattr(module, attr)  # AttributeError exactly as the real module
                doc = (getattr(fn, "__doc__", "") or "").splitlines()
                sig = doc[0] if doc else ""
                m = re.match(r"\w+\((.*)\)\s*->\s*(.*)$", sig)
                params = []
                if m and m.group(1).strip():
                    depth, cur = 0, ""
                    for ch in m.group(1):
                        depth += ch in "[("
                        depth -= ch in "])"
                        if ch == "," and depth == 0:
                            params.append(cur.strip())
                            cur = ""
                        else:
                            cur += ch
                    params.append(cur.strip())
                returns_none = bool(m) and m.group(2).strip() == "None"

                def call(*args, **kwargs):
                    import torch
                    if Trace.in_kernel:
                        Trace.events.append(("ext", f"{ext_name}.{attr}"))
                    if m and not kwargs:
                        if len(args) != len(params):
                            out["ext_errors"].append({"what": f"{ext_name}.{attr}", "line": Trace.site(), "case": Trace.case,
                                                      "error": f"called with {len(args)} args, the binding takes {len(params)}: {sig}"})
                            raise TypeError(f"{attr}(): incompatible function arguments ({len(args)} given, {len(params)} expected)")
                        for i, (a, p) in enumerate(zip(args, params)):
                            want_t = "Tensor" in p and "Optional" not in p and "None" not in p
                            # Sequence[Tensor] / List[Tensor] bindings take a list or tuple of tensors
                            seq = want_t and re.search(r"(Sequence|List|list)\[", p) is not None
                            if seq and isinstance(a, (list, tuple)) and all(isinstance(e, (torch.Tensor, Stub)) for e in a):
                                continue
                            if want_t and not isinstance(a, torch.Tensor) and not isinstance(a, Stub):
                                out["ext_errors"].append({"what": f"{ext_name}.{attr}", "line": Trace.site(), "case": Trace.case,
                                                          "error": f"arg {i} is {type(a).__name__}, the binding wants {p}"})
                                raise TypeError(f"{attr}(): incompatible function arguments (arg {i})")
                    return None if returns_none else Stub(f"{ext_name}.{attr}()")
                return call
        return Ext()
    return stub_ext


def _alarm(seconds):
    import signal

    def handler(*a):
        raise TimeoutError(f"precheck: no result after {seconds} s")
    signal.signal(signal.SIGALRM, handler)
    signal.alarm(seconds)


def _cancel_alarm():
    import signal
    signal.alarm(0)


def _to_meta(x, torch):
    if isinstance(x, torch.Tensor):
        return x.to("meta")
    if isinstance(x, dict):
        return {k: _to_meta(v, torch) for k, v in x.items()}
    if isinstance(x, (list, tuple)):
        return type(x)(_to_meta(v, torch) for v in x)
    return x


def _describe(x, torch):
    if isinstance(x, torch.Tensor):
        return f"{str(x.dtype).replace('torch.', '')}{list(x.shape)}"
    if isinstance(x, (tuple, list)):
        return "(" + ", ".join(_describe(v, torch) for v in x) + ")"
    if isinstance(x, dict):
        return "{" + ", ".join(f"{k}: {_describe(v, torch)}" for k, v in x.items()) + "}"
    return type(x).__name__ if not isinstance(x, Stub) else repr(x)


def _exc_record(e, sub_file):
    import traceback as tb
    frames = [f for f in tb.extract_tb(e.__traceback__) if f.filename == sub_file]
    line = frames[-1].lineno if frames else 0
    src = frames[-1].line if frames else ""
    text = f"{type(e).__name__}: {str(e)[:600]}"
    # Our meta/driver hooks raise EmulationLimit. Other exceptions need an actual
    # stub value at the failure site; words such as NoneType, metadata or stub in
    # an ordinary Python error do not identify an emulation limitation.
    stub = (_stub_library(e, sub_file, src or "")
            if isinstance(e, (EmulationLimit, TypeError, ValueError, AttributeError, IndexError)) else None)
    emu = isinstance(e, EmulationLimit) or stub is not None
    sync = isinstance(e, HostSync)
    if re.search(r"item\(\) cannot be called on meta|Cannot copy out of meta|data-dependent|nonzero.*meta", str(e)):
        sync, emu, stub = True, False, None
        if Trace.in_kernel:
            Trace.hazards.append({"kind": "sync", "what": f"host sync ({str(e)[:80]})", "line": line, "case": Trace.case})
    return {"line": line, "src": (src or "")[:160], "error": text, "emulation": bool(emu), "stub": stub,
            "host_sync": sync, "tail": "".join(tb.format_exception(e))[-2500:]}


def _stub_library(e, sub_file, src_line):
    """The stubbed library (top-level package) whose stand-in result stopped the trace, or None when nothing ties
    the stop to a stub (a meta-tensor op, a Triton driver call, or an ordinary bug such as a None)."""
    type_error = (isinstance(e, TypeError) and re.search(
        r"(?:not |got |type.*['\"])Stub\b", str(e)))
    unpack_error = (isinstance(e, ValueError) and re.fullmatch(
        r"(?:not enough values to unpack \(expected \d+, got \d+\)|too many values to unpack \(expected \d+\))", str(e)))
    if not isinstance(e, EmulationLimit) and not type_error and not unpack_error:
        return None
    tbk, last = e.__traceback__, None
    while tbk is not None:
        if tbk.tb_frame.f_code.co_filename == sub_file:
            last = tbk.tb_frame
        tbk = tbk.tb_next
    if last is None:
        return None
    vals = [last.f_locals.get(k, last.f_globals.get(k)) for k in re.findall(r"[A-Za-z_]\w*", src_line)]
    vals += [v for d in list(vals) if isinstance(d, dict) for v in list(d.values())[:200]]
    for v in vals:
        if isinstance(v, Stub):
            return v._name.split(".")[0]
    return None


def container_main(stage: Path):
    """Runs every container stage; whatever crashes is reported as skipped with its reason."""
    try:
        return _container_main(stage)
    except BaseException as e:  # noqa: BLE001
        import traceback
        res = stage / "result.json"
        partial = json.loads(res.read_text()) if res.is_file() else {}
        partial["fatal"] = f"{type(e).__name__}: {str(e)[:600]}"
        partial["fatal_tail"] = traceback.format_exc()[-3000:]
        res.write_text(json.dumps(partial, default=str))
        print(f"[precheck] container stage crashed: {partial['fatal']}", flush=True)
        return 0


def _container_main(stage: Path):
    import io
    import importlib.util
    import traceback

    cfg = json.loads((stage / "config.json").read_text())
    out = {"builds": [], "triton": [], "triton_errors": [], "triton_compiled": {}, "ext_errors": [], "cases": [],
           "import": {}, "prepare": {}, "stubbed": [], "env": {}, "leftover_builds": [], "unlaunched_triton": []}
    out["cases_discovered"] = sum(len(cases) for cases in cfg.get("cases", {}).values())
    os.environ.setdefault("TORCH_CUDA_ARCH_LIST", "9.0+PTX")  # what torch derives from one visible H200
    os.environ["TORCH_EXTENSIONS_DIR"] = "/tmp/torch_extensions"
    os.environ["TRITON_CACHE_DIR"] = "/tmp/triton_cache"
    os.environ.setdefault("MAX_JOBS", "8")
    sys.path.insert(0, str(stage))
    sub_file = str(stage / "submission.py")
    Trace.sub_file = sub_file

    values = {}
    if cfg.get("judge_cutlass"):  # mounted by the host side; see FLASHINFER_WHEEL
        root = Path(cfg["judge_cutlass"])
        values["flashinfer.jit.env"] = {"CUTLASS_INCLUDE_DIRS": [root / "include", root / "tools" / "util" / "include"]}
    out["stubbed_packages"] = sorted(install_stub_importer(out["stubbed"], values))
    import torch
    import triton
    out["env"] = {"torch": torch.__version__, "torch_cuda": torch.version.cuda, "triton": triton.__version__,
                  "nvcc": subprocess.run(["nvcc", "--version"], capture_output=True, text=True).stdout.strip().splitlines()[-1],
                  "TORCH_CUDA_ARCH_LIST": os.environ["TORCH_CUDA_ARCH_LIST"]}
    MetaCuda = install_gpu_emulation(torch, out)
    install_triton_emulation(out)
    out["stage"] = str(stage)
    install_build_recorder(torch, out, make_ext_stub(out), cfg.get("sass"))
    mode = MetaCuda()
    mode.__enter__()
    printed = io.StringIO()

    class Tee(io.TextIOBase):
        def write(self, s):
            printed.write(s)
            return len(s)

        def flush(self):
            pass
    real_stdout = sys.stdout

    def finish():
        mode.__exit__(None, None, None)
        sys.stdout = real_stdout
        out["printed_tail"] = printed.getvalue()[-6000:]
        finalize_triton(out, stage)
        for b in out["builds"]:
            b.pop("_module", None)
        out.pop("triton_compiled", None)
        (stage / "result.json").write_text(json.dumps(out, default=str))

    # ---- import, as the judge does
    print("[precheck] importing the submission (emulated H200) ...", flush=True)
    spec = importlib.util.spec_from_file_location("submission", sub_file)
    sub = importlib.util.module_from_spec(spec)
    sys.modules["submission"] = sub
    sys.stdout = Tee()
    t0 = time.time()
    try:
        _alarm(900)
        spec.loader.exec_module(sub)
        out["import"] = {"ok": True}
    except BaseException as e:  # keep going with whatever was defined
        out["import"] = {"ok": False, **_exc_record(e, sub_file)}
        if isinstance(e, KeyboardInterrupt):
            raise
        _exec_rest(sub, sub_file)
    finally:
        _cancel_alarm()
        out["import"]["seconds"] = round(time.time() - t0, 1)
    sys.stdout = real_stdout

    problem = cfg.get("problem")
    ref = None
    if cfg.get("has_reference") and not cfg.get("no_trace"):
        try:
            mode.__exit__(None, None, None)
            import reference as ref  # noqa: F401  (the harness's own copy, for inputs only)
        except BaseException as e:
            out["notes"] = [f"reference.py import failed: {e}"]
            ref = None
        finally:
            mode.__enter__()

    # ---- prepare(weights)
    state = weights = None
    if ref is not None and hasattr(sub, "prepare") and hasattr(ref, "generate_weights"):
        print("[precheck] prepare(weights) on meta tensors ...", flush=True)
        try:
            mode.__exit__(None, None, None)
            seed = getattr(ref, "WEIGHTS_SEED", 0)
            weights = _to_meta(ref.generate_weights(seed, device="cpu"), torch)
        finally:
            mode.__enter__()
        sys.stdout = Tee()
        t0 = time.time()
        Trace.compared = []
        try:
            _alarm(1200)
            state = sub.prepare(weights)
            out["prepare"] = {"ok": True}
        except BaseException as e:
            out["prepare"] = {"ok": False, **_exc_record(e, sub_file)}
        finally:
            _cancel_alarm()
            out["prepare"]["seconds"] = round(time.time() - t0, 1)
            out["prepare"]["compared"] = sorted(set(Trace.compared))
            sys.stdout = real_stdout

    # ---- kernel_fn over scored, test and nearby shapes; not with the state=None a prepare() that stopped at an
    # emulation limit leaves, which only produces misleading failures
    if out["prepare"].get("emulation"):
        print("[precheck] prepare() stopped at an emulation limit: kernel_fn is not traced", flush=True)
    elif ref is not None and hasattr(sub, "kernel_fn") and hasattr(ref, "generate_input") and not cfg.get("no_trace"):
        import inspect
        nargs = len([p for p in inspect.signature(sub.kernel_fn).parameters.values() if p.default is p.empty])
        for group in ("scored", "tests", "nearby"):
            cases = cfg["cases"][group]
            print(f"[precheck] kernel_fn over {len(cases)} {group} shapes ...", flush=True)
            for case in cases:
                label = ", ".join(f"{k} {v}" for k, v in case.items() if k != "seed")
                rec = {"group": group, "case": label}
                try:
                    mode.__exit__(None, None, None)
                    data = _to_meta(ref.generate_input(**case, device="cpu"), torch)
                except BaseException as e:
                    rec.update(status="skipped", error=f"generate_input failed: {type(e).__name__}: {str(e)[:200]}")
                    out["cases"].append(rec)
                    continue
                finally:
                    mode.__enter__()
                expect = _expected_output(ref, data, weights, torch)
                Trace.case, Trace.events, Trace.stub_calls, Trace.in_kernel = label, [], [], True
                sys.stdout = Tee()
                try:
                    _alarm(cfg.get("case_timeout", 120))
                    res = sub.kernel_fn(data, state) if nargs >= 2 else sub.kernel_fn(data)
                    rec["status"] = "ok"
                    rec["output"] = _describe(res, torch)
                    if expect and isinstance(res, torch.Tensor) and rec["output"] != expect:
                        rec["status"] = "bad-output"
                        rec["error"] = f"returns {rec['output']}, the reference returns {expect}"
                    elif expect and not isinstance(res, torch.Tensor) and not isinstance(res, Stub) and "[" in expect:
                        rec["status"] = "bad-output"
                        rec["error"] = f"returns {rec['output']}, the reference returns {expect}"
                except BaseException as e:
                    r = _exc_record(e, sub_file)
                    rec.update(status="host-sync" if r["host_sync"] else ("emulation" if r["emulation"] else "raised"), **r)
                    if isinstance(e, KeyboardInterrupt):
                        raise
                finally:
                    _cancel_alarm()
                    Trace.in_kernel = False
                    sys.stdout = real_stdout
                rec["path"] = _path_summary(Trace.events)
                out["cases"].append(rec)
            Trace.case = None
    out["hazards"] = Trace.hazards

    # ---- build sites the trace never reached
    reached = {c for b in out["builds"] for c in b["calls"]}
    try:
        mod = Module(Path(sub_file))
        for site in _build_sites(mod):
            if site["line"] in reached or any(abs(site["line"] - r) <= 3 for r in reached):
                continue
            fn = getattr(sub, site["func"], None) if site["func"] else None
            how = None
            if callable(fn):
                import inspect
                try:
                    req = [p for p in inspect.signature(fn).parameters.values()
                           if p.default is p.empty and p.kind in (p.POSITIONAL_ONLY, p.POSITIONAL_OR_KEYWORD)]
                except (TypeError, ValueError):
                    req = ["?"]
                if not req:
                    how = f"called {site['func']}()"
                    sys.stdout = Tee()
                    try:
                        _alarm(900)
                        fn()
                    except BaseException:
                        pass
                    finally:
                        _cancel_alarm()
                        sys.stdout = real_stdout
            if how is None:
                call = next(n for n in ast.walk(mod.tree) if isinstance(n, ast.Call) and n.lineno == site["line"])
                try:
                    expr = ast.Expression(body=call)
                    ast.fix_missing_locations(expr)
                    _alarm(900)
                    eval(compile(expr, sub_file, "eval"), vars(sub), {})
                    how = "evaluated the call with module globals"
                except BaseException as e:
                    how = how or f"could not reproduce: {type(e).__name__}: {str(e)[:160]}"
                finally:
                    _cancel_alarm()
            out["leftover_builds"].append({"line": site["line"], "how": how})
        launched = {v["kernel"] for v in out["triton_compiled"].values()}
        out["unlaunched_triton"] = sorted(n for n in mod.triton_kernels if n not in launched)
        out["triton_lines"] = {n: mod.funcs[n].lineno for n in mod.triton_kernels}
    except BaseException as e:
        out["notes"] = out.get("notes", []) + [f"leftover-site pass failed: {e}"]
    finish()
    return 0


def _exec_rest(sub, sub_file):
    """After a failed import, run the remaining top-level statements one by one so later
    stages still see the definitions."""
    tree = ast.parse(Path(sub_file).read_text())
    ns = vars(sub)
    for node in tree.body:
        name = getattr(node, "name", None)
        if name and name in ns:
            continue
        try:
            code = compile(ast.Module(body=[node], type_ignores=[]), sub_file, "exec")
            exec(code, ns)
        except BaseException:
            pass


def _expected_output(ref, data, weights, torch):
    """Shape/dtype of the reference output, run on meta tensors (None if it can't run there)."""
    fn = getattr(ref, "ref_kernel", None)
    if fn is None:
        return None
    try:
        import inspect
        n = len(inspect.signature(fn).parameters)
        if n >= 2 and weights is None:
            return None
        _alarm(60)
        res = fn(data) if n == 1 else fn(data, weights)
        return _describe(res, torch)
    except BaseException:
        return None
    finally:
        _cancel_alarm()


def _path_summary(events):
    seen, out = set(), []
    for kind, name in events:
        if (kind, name) not in seen:
            seen.add((kind, name))
            out.append(f"{kind}:{name}")
    return out


def finalize_triton(out, stage):
    work = stage / "triton_ptx"
    work.mkdir(exist_ok=True)
    rows = []
    for (name, h), v in out.get("triton_compiled", {}).items():
        k = v.pop("obj", None)
        row = {kk: (sorted(vv) if isinstance(vv, set) else vv) for kk, vv in v.items()}
        try:
            ptx = k.asm.get("ptx") if k is not None else None
            if ptx:
                usage, row["ptxas_diag"] = ptxas_usage(ptx, work, f"{name}_{str(h)[:8]}")
                if usage:
                    u = next(iter(usage.values()))
                    row.update(regs=u.get("regs"), spill_st=u.get("spill_st"), spill_ld=u.get("spill_ld"),
                               stack=u.get("stack"), static_smem=u.get("smem"))
        except Exception as e:
            row["usage_error"] = str(e)[:200]
        rows.append(row)
    out["triton"] = rows


