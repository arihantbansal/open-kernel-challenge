def find_problem_dir(sub: Path, problem: str) -> Path | None:
    for d in (sub.parent, ROOT / "problems" / problem):
        if (d / "reference.py").is_file():
            return d
    return None


def parse_cases(problem: str, problem_dir: Path | None):
    """Scored shapes, the judge's pre-timing tests, and nearby shapes, as generate_input kwargs."""
    spec = TOOLS_DIR / "okc-docs" / f"{problem}.json"
    scored, tests, task_md = [], [], None
    if spec.is_file():
        d = json.loads(spec.read_text())
        scored = [{k: v for k, v in b.items() if k not in ("load", "weight", "repeats")} for b in d.get("benchmarks", [])]
        task_md = d.get("task_md")
    if task_md is None and problem_dir and (problem_dir / "TASK.md").is_file():
        task_md = (problem_dir / "TASK.md").read_text()
    if task_md:
        m = re.search(r"must pass these.*?```\n(.*?)```", task_md, re.S)
        for i, line in enumerate((m.group(1) if m else "").strip().splitlines()):
            case = {}
            for part in line.split(","):
                k, _, v = part.strip().partition(" ")
                v = v.strip()
                try:
                    case[k] = int(v)
                except ValueError:
                    try:
                        case[k] = float(v)
                    except ValueError:
                        case[k] = v
            case["seed"] = 9000 + i
            tests.append(case)
    size_key = next((k for k in ("m", "bs", "batch") if scored and k in scored[0]), None)
    nearby, have = [], {tuple(sorted(c.items())) for c in scored}
    if size_key:
        values = sorted({c[size_key] for c in scored})
        protos = {}
        for c in scored:
            protos.setdefault(c[size_key], []).append(c)
        for v in values:
            for nv in (v - 1, v + 1):
                if nv < 1 or nv in values:
                    continue
                for c in protos[v]:
                    n = dict(c, **{size_key: nv, "seed": c.get("seed", 0) + 7000})
                    key = tuple(sorted((k, x) for k, x in n.items() if k != "seed"))
                    if key not in have:
                        have.add(key)
                        nearby.append(n)
        if scored and "q_len" in scored[0] and size_key == "batch":  # prefill: perturb the block length too
            for c in scored:
                if c.get("q_len", 1) > 8:
                    nearby.append(dict(c, q_len=c["q_len"] + 1, seed=c.get("seed", 0) + 7100))
    return {"scored": scored, "tests": tests, "nearby": nearby}


def ensure_image(rebuild=False):
    have = subprocess.run(["docker", "image", "inspect", IMAGE], capture_output=True).returncode == 0
    if have and not rebuild:
        return True
    with docker_lock():
        print(f"[precheck] building {IMAGE} from {TOOLS_DIR / 'Dockerfile'} (one-time, several GB) ...", file=sys.stderr)
        r = subprocess.run(["docker", "build", "-t", IMAGE, "-f", str(TOOLS_DIR / "Dockerfile"), str(TOOLS_DIR)])
    return r.returncode == 0


