def ensure_cutlass_headers() -> Path | None:
    """The CUTLASS include tree of the judge's flashinfer wheel, extracted once into CUTLASS_CACHE."""
    if (CUTLASS_CACHE / "include" / "cute" / "tensor.hpp").is_file():
        return CUTLASS_CACHE
    import hashlib
    import tempfile
    import urllib.request
    import zipfile
    url, sha = FLASHINFER_WHEEL
    print(f"[precheck] fetching CUTLASS headers from {url.rsplit('/', 1)[-1]} into {CUTLASS_CACHE} (one-time) ...",
          file=sys.stderr, flush=True)
    prefix = "flashinfer/data/cutlass/"
    try:
        CUTLASS_CACHE.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(dir=CUTLASS_CACHE.parent) as tmp:
            wheel, dest = Path(tmp) / "flashinfer.whl", Path(tmp) / "cutlass"
            urllib.request.urlretrieve(url, wheel)
            if hashlib.sha256(wheel.read_bytes()).hexdigest() != sha:
                raise OSError(f"sha256 of {wheel.name} does not match {sha}")
            with zipfile.ZipFile(wheel) as z:
                for name in z.namelist():
                    rel = name[len(prefix):] if name.startswith(prefix) else ""
                    if rel.startswith(("include/", "tools/util/include/")) and not rel.endswith("/") \
                            and ".." not in Path(rel).parts:
                        (dest / rel).parent.mkdir(parents=True, exist_ok=True)
                        (dest / rel).write_bytes(z.read(name))
            dest.rename(CUTLASS_CACHE)
    except OSError as e:
        if (CUTLASS_CACHE / "include" / "cute" / "tensor.hpp").is_file():  # another precheck fetched it first
            return CUTLASS_CACHE
        print(f"[precheck] could not fetch CUTLASS headers: {e}", file=sys.stderr, flush=True)
        return None
    return CUTLASS_CACHE


@contextlib.contextmanager
def docker_lock():
    """tools/dock's two slot locks, so a precheck runs alone and dock runs take turns; see tools/dock for why
    it is a kernel lock plus a wait for labelled containers a killed holder left running."""
    import fcntl
    # both of tools/dock's slots: a 10 GB precheck container and a 6 GB dock one would overfill the VM
    with open(DOCK_LOCK, "a") as f, open(f"{DOCK_LOCK}.2", "a") as f2:  # closing (or dying) releases the locks
        for lk in (f, f2):
            try:
                fcntl.lockf(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                print("[precheck] waiting for another agent's container", file=sys.stderr, flush=True)
                fcntl.lockf(lk, fcntl.LOCK_EX)
        said = False
        while ids := subprocess.run(["docker", "ps", "-q", "--filter", f"label={DOCK_LABEL}"],
                                    capture_output=True, text=True).stdout.split():
            if not said:
                print(f"[precheck] waiting for okc container(s) {' '.join(ids)} left by a killed run", file=sys.stderr, flush=True)
                said = True
            time.sleep(5)
        yield


def run_container(rep: Report, sub: Path, problem: str | None, args) -> None:
    import shutil
    import tempfile
    if shutil.which("docker") is None or subprocess.run(["docker", "info"], capture_output=True).returncode != 0:
        for s in ("build", "trace", "triton"):
            rep.stages[s] = {"status": "SKIP", "why": "docker is not available"}
        return
    if not ensure_image(args.rebuild_image):
        for s in ("build", "trace", "triton"):
            rep.stages[s] = {"status": "SKIP", "why": "image build failed"}
        return
    stage = Path(tempfile.mkdtemp(prefix="okc-precheck-", dir=args.stage_root))
    try:
        shutil.copy(sub, stage / "submission.py")
        pdir = find_problem_dir(sub, problem) if problem else None
        for f in ("reference.py", "checks.py", "nvfp4.py"):
            if pdir and (pdir / f).is_file():
                shutil.copy(pdir / f, stage / f)
        cases = parse_cases(problem, pdir) if problem else {"scored": [], "tests": [], "nearby": []}
        if args.no_trace:
            cases = {"scored": [], "tests": [], "nearby": []}
        elif args.quick:
            cases["tests"], cases["nearby"] = [], cases["nearby"][: len(cases["scored"]) // 2]
        mounts, judge_cutlass = [], None
        if cutlass := ensure_cutlass_headers():
            mounts, judge_cutlass = ["-v", f"{cutlass}:{JUDGE_CUTLASS}:ro"], JUDGE_CUTLASS
        else:
            rep.details["notes"] = rep.details.get("notes", []) + [
                "no CUTLASS headers: flashinfer.jit.env.CUTLASS_INCLUDE_DIRS is empty, so CUTLASS/CuTe builds fail here"]
        cfg = {"problem": problem, "cases": cases, "no_trace": bool(args.no_trace), "has_reference": bool(pdir),
               "case_timeout": args.case_timeout, "sass": args.sass, "judge_cutlass": judge_cutlass}
        (stage / "config.json").write_text(json.dumps(cfg))
        name = f"okc-precheck-{os.getpid()}"
        cmd = ["docker", "run", "--rm", "--label", DOCK_LABEL, "--name", name, "--network", "none",
               "--memory", args.memory, "--shm-size", "1g", "-v", f"{stage}:/stage", "-v", f"{TOOLS_DIR}:/tools:ro",
               *mounts, IMAGE,  # run this same file inside
               "python", "-u", f"/tools/{Path(__file__).name}", "--in-container", "/stage"]
        with docker_lock():
            t0 = time.time()
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
            try:
                tail = []
                for line in proc.stdout:
                    tail.append(line.rstrip())
                    tail = tail[-200:]
                    if line.startswith("[precheck]") and not args.json:
                        print(line.rstrip(), file=sys.stderr, flush=True)
                proc.wait()
            except BaseException:  # interrupted: stop the container before giving the lock away
                subprocess.run(["docker", "rm", "-f", name], capture_output=True)
                raise
            rep.details["container_seconds"] = round(time.time() - t0, 1)
        res_path = stage / "result.json"
        if not res_path.is_file():
            why = (f"skipped: the container was killed (exit {proc.returncode}, likely out of memory under "
                   f"--memory {args.memory}; try a larger --memory or --no-trace)") if proc.returncode in (137, -9) else \
                f"skipped: the container exited {proc.returncode} without a result (output tail below)"
            for s in ("build", "trace", "triton"):
                rep.stages[s] = {"status": "SKIP", "why": why}
            rep.details["container_tail"] = [l for l in tail if l.strip() and not re.match(
                r"=+|CUDA Version|Container image|This container|By pulling|https://|A copy of|WARNING: The NVIDIA|   Use the NVIDIA|== CUDA", l)][-40:]
            return
        res = json.loads(res_path.read_text())
        for b in res.get("builds", []):  # sass paths were written inside the container under /stage
            for s in b.get("sass", []):
                s["path"] = str(stage / Path(s["path"]).relative_to("/stage"))
        merge_container_result(rep, res)
        if args.sass:
            dumped = [s for b in res.get("builds", []) for s in b.get("sass", [])]
            for s in dumped:
                print(f"[precheck] sass {s['kernel'][:70]}: {s['path']}", file=sys.stderr)
            if not dumped:
                print(f"[precheck] --sass {args.sass!r}: no built kernel matched", file=sys.stderr)
    finally:
        if not args.keep_stage and not args.sass:
            shutil.rmtree(stage, ignore_errors=True)
        else:
            print(f"[precheck] stage kept at {stage}", file=sys.stderr)


def _first_errors(text: str, n=4):
    lines = [l.strip() for l in text.splitlines() if re.search(r"\berror\b|fatal", l, re.I)
             and not re.search(r"Error building extension|nvcc -|c\+\+ -MMD|^\d+ \|", l.strip())]
    seen, out = set(), []
    for l in lines:
        l = re.sub(r"^/\S+/(\w+\.(?:cu|cpp|cuh|h))", r"\1", l)
        if l not in seen:
            seen.add(l)
            out.append(l[:240])
    return out[:n] or [text.strip().splitlines()[-1][:240] if text.strip() else "unknown error"]


def _short_kernel(name: str, width: int):
    nm = re.sub(r"^void ", "", name)
    nm = re.sub(r"\((?:[^()]|\([^()]*\))*\)$", "", nm)  # drop the parameter list
    nm = re.sub(r"\((?:int|bool|unsigned int|long)\)", "", nm)
    return nm if len(nm) <= width else nm[:width - 3] + "..."


def _ptxas_diag_findings(rep, stage, line, diag, names, usage, where):
    """One WARN per kernel and diagnostic: wgmma serialization (C751x) and register spills."""
    done = set()
    for d in diag:
        k = d.get("kernel")
        kname = _short_kernel(names.get(k, k), 90) if k else "?"
        if d["code"] == "spill":
            if (k, "spill") in done:
                continue
            u = usage.get(k, {})
            msg = (f"{kname} {where} spills: {u.get('spill_st')} B stores / {u.get('spill_ld')} B loads at {u.get('regs')} regs"
                   if u.get("spill_st") or u.get("spill_ld") else f"{kname} {where}: {d['text'][:200]}")
            rep.add(stage, "WARN", line, "ptxas.spill", msg)
        else:
            if (k, d["code"]) in done:
                continue
            text = re.sub(r"\s+in the function\s+'?[\w$]+'?", "", d["text"].split(":", 1)[-1].strip())
            rep.add(stage, "WARN", line, "ptxas.serialized", f"{kname} {where}: {text[:260]}")
        done.add((k, d["code"]))


def merge_container_result(rep: Report, res: dict):
    sections = rep.details.setdefault("sections", [])
    cases = res.get("cases", [])
    counts = {"discovered": res.get("cases_discovered", len(cases)),
              "reached": sum(c["status"] != "skipped" for c in cases),
              "completed": sum(c["status"] == "ok" for c in cases),
              "compiled": len(res.get("triton", []))}
    if res.get("fatal") and not res.get("builds") and not res.get("cases"):
        for s in ("build", "trace", "triton"):
            rep.stages[s] = {"status": "SKIP", "why": f"skipped: precheck's container run crashed ({res['fatal'][:200]})"}
        rep.stages["trace"].update(counts)
        sections.append("-- container crash (a precheck bug, not a finding)\n" + res.get("fatal_tail", ""))
        return
    if res.get("fatal"):
        sections.append("-- container crash after partial results (a precheck bug, not a finding)\n" + res.get("fatal_tail", "")[-1500:])
    env = res.get("env", {})
    rep.details["container_env"] = env
    sites = {b["line"]: b for b in rep.details.get("build_sites", [])}
    swallowed = {}
    for f in rep.findings:
        if f.rule == "build.swallowed":
            swallowed[f.line] = True

    # ---------------- build
    S = "build"
    builds = res.get("builds", [])
    lines = [f"-- build (nvcc {env.get('nvcc', '?')}, torch {env.get('torch')}, "
             f"TORCH_CUDA_ARCH_LIST={env.get('TORCH_CUDA_ARCH_LIST')} as on one H200)"]
    for b in builds:
        where = f"line {b['line']}"
        if b.get("ok"):
            lines.append(f"  {b['kind']} {b['name']!r} ({where}): built in {b['seconds']} s")
        else:
            errs = _first_errors(b.get("error", ""))
            sw = " The file catches the failure and silently falls back." if any(
                abs(b["line"] - l) <= 3 for l in swallowed) else ""
            rep.add(S, "ERROR", b["line"], "build.fail",
                    f"{b['kind']} {b['name']!r} fails to compile:{sw} " + " | ".join(errs))
            lines.append(f"  {b['kind']} {b['name']!r} ({where}): FAILED after {b['seconds']} s")
            for e in errs:
                lines.append(f"      {e}")
        raw = re.sub(r"-isystem \S+ ?", "", b.get("ninja_cuda_flags", "") + " " + b.get("ninja_post_cflags", ""))
        flags = " ".join(x for x in raw.split() if not x.startswith(("-I", "-DTORCH_", "-DPYBIND11", "-D_GLIBCXX", "-D__CUDA_NO")))
        if flags:
            lines.append(f"      nvcc flags: {flags[:400]}")
            stds = re.findall(r"-std=\S+", flags)
            if len(set(stds)) > 1:
                lines.append(f"      note: several -std flags {stds}; nvcc uses the last one")
        if b.get("warnings"):
            lines.append(f"      {len(b['warnings'])} compiler warning(s), e.g. {b['warnings'][0][:160]}")
        ptx = b.get("ptxas", {})
        if ptx:
            names = b.get("ptxas_names", {})
            lines.append(f"      {'kernel (template args shortened)':64s} {'regs':>5s} {'spill st/ld':>12s} {'stack':>6s} {'static smem':>11s}")
            for mangled, u in sorted(ptx.items(), key=lambda kv: (-kv[1].get("spill_st", 0) - kv[1].get("spill_ld", 0), -kv[1].get("regs", 0))):
                short = _short_kernel(names.get(mangled, mangled), 64)
                lines.append(f"      {short:64s} {u.get('regs', 0):5d} {u.get('spill_st', 0):5d}/{u.get('spill_ld', 0):<6d} "
                             f"{u.get('stack', 0):6d} {u.get('smem', 0):11d}")
        _ptxas_diag_findings(rep, S, b["line"], b.get("ptxas_diag", []), b.get("ptxas_names", {}),
                             b.get("ptxas", {}), f"in {b['name']!r}")
        for s in b.get("sass", []):
            lines.append(f"      sass {s['kernel'][:60]}: {s['path']}")
        if b.get("sass_error"):
            lines.append(f"      sass dump failed: {b['sass_error']}")
        if b.get("ok") and b["seconds"] > 120:
            rep.add(S, "WARN", b["line"], "build.slow",
                    f"{b['name']!r} takes {b['seconds']} s to build here; if it builds inside prepare() it eats the 300 s budget")
        elif b.get("ok"):
            rep.add(S, "INFO", b["line"], "build.ok", f"{b['name']!r} built in {b['seconds']} s")
    for lb in res.get("leftover_builds", []):
        if lb["how"].startswith("could not"):
            rep.add(S, "WARN", lb["line"], "build.unchecked", f"build call not reached and not reproducible, so not compile-checked: {lb['how']}")
        else:
            lines.append(f"  line {lb['line']}: not reached by import/prepare/kernel_fn; {lb['how']}")
    if not builds and not sites:
        lines.append("  no load_inline / cpp_extension.load calls")
    sections.append("\n".join(lines))
    n_fail = sum(not b.get("ok") for b in builds)
    rep.stages[S] = {"status": "FAIL" if n_fail else "PASS",
                     "why": (f"{n_fail} of {len(builds)} extension(s) fail to compile" if n_fail else
                             f"{len(builds)} extension(s) compile for sm_90a" if builds else "nothing to build")}

    # ---------------- trace
    S = "trace"
    imp, prep = res.get("import", {}), res.get("prepare", {})
    tl = [f"-- trace (emulated H200: meta tensors; stubbed: {', '.join(res.get('stubbed_packages', [])) or 'nothing'})"]
    tl.append(f"  import: {'ok' if imp.get('ok') else 'RAISED'} ({imp.get('seconds', 0)} s)")
    if imp and not imp.get("ok"):
        sev = "WARN" if imp.get("emulation") else "ERROR"
        rep.add(S, sev, imp.get("line"), "import.raises",
                f"importing the file raises {imp.get('error')}" + (" (maybe an emulation limit)" if imp.get("emulation") else ""))
    if prep:
        tl.append(f"  prepare: {'ok' if prep.get('ok') else 'RAISED'} ({prep.get('seconds', 0)} s on meta tensors; GPU tuning is not reproduced)")
        if not prep.get("ok"):
            sev = "WARN" if prep.get("emulation") else "ERROR"
            rep.add(S, sev, prep.get("line"), "prepare.raises",
                    f"prepare() raises {prep.get('error')} at `{prep.get('src', '')}`" +
                    (" (maybe an emulation limit; later cases ran with state=None)" if prep.get("emulation") else ""))
    cases = res.get("cases", [])
    seen_h = set()
    for h in res.get("hazards", []):
        key = (h["line"], h["what"])
        if key in seen_h:
            continue
        seen_h.add(key)
        sev = "WARN" if h["kind"] in ("h2d", "timing") else "ERROR"
        rep.add(S, sev, h["line"], f"graph.{h['kind']}", f"{h['what']} (first seen on {h['case']})")
    for e in res.get("ext_errors", []):
        rep.add(S, "ERROR", e["line"], "ext.args", f"{e['what']}: {e['error']} (case {e['case']})")
    by_status = {}
    for c in cases:
        by_status.setdefault(c["status"], []).append(c)
    emu_lines = {}
    for c in cases:
        if c["status"] == "raised":
            where = {"scored": "a scored shape", "tests": "a judge test shape (the run fails before timing)",
                     "nearby": "a nearby shape (final review reruns nearby shapes)"}[c["group"]]
            rep.add(S, "ERROR", c.get("line"), "shape.raises",
                    f"kernel_fn raises on {where} [{c['case']}]: {c.get('error')} at `{c.get('src', '')}`")
        elif c["status"] == "bad-output":
            rep.add(S, "ERROR", 0, "shape.output", f"[{c['case']}] {c.get('error')}")
        elif c["status"] == "emulation":
            emu_lines.setdefault((c.get("line"), c.get("error", "")[:120]), []).append(c["case"])
        elif c["status"] == "skipped":
            rep.add(S, "INFO", 0, "trace.skipped", f"[{c['case']}] {c.get('error')}")
    for (line, err), cs in emu_lines.items():
        rep.add(S, "INFO", line, "trace.emulation",
                f"trace of {len(cs)} case(s) stopped here (emulation limit, not a finding): {err}")
    # dedupe repeated shape errors into one finding per (line, error)
    dedup, merged = {}, []
    for f in rep.findings:
        if f.stage == S and f.rule in ("shape.raises",):
            key = (f.line, f.message.split("]: ", 1)[-1])
            if key in dedup:
                dedup[key][0] += 1
                continue
            dedup[key] = [1, f]
        merged.append(f)
    for n, f in dedup.values():
        if n > 1:
            f.message += f" (+{n - 1} more shapes)"
    rep.findings = merged
    if cases:
        tl.append(f"  kernel_fn: {len(cases)} shapes: " + ", ".join(f"{len(v)} {k}" for k, v in sorted(by_status.items())))
        paths = {}
        for c in cases:
            sig = " ".join(c.get("path", [])) or "(torch ops / cuBLAS only: no Triton, extension or library launches)"
            if c["status"] not in ("ok",):
                sig += f"  [{c['status']}]"
            paths.setdefault(sig, []).append(f"{c['group'][0]}:{c['case']}")
        tl.append("  paths taken (s = scored, t = test, n = nearby):")
        for sig, cs in paths.items():
            tl.append(f"    {sig[:220]}")
            tl.append(f"        {len(cs)} shape(s): " + "; ".join(cs[:6]) + (" ..." if len(cs) > 6 else ""))
    if res.get("printed_tail"):
        pr = [l for l in res["printed_tail"].splitlines() if l.strip()][-8:]
        tl.append("  last lines the submission printed:")
        tl.extend(f"    | {l[:200]}" for l in pr)
    tl.append(f"  cases: {counts['discovered']} discovered, {counts['reached']} reached kernel_fn, "
              f"{counts['completed']} completed; {counts['compiled']} Triton specialization(s) compiled")
    sections.append("\n".join(tl))
    rep.stages[S] = {**trace_status(rep, imp, prep, cases), **counts}
    _finish_triton(rep, res, sections, env)


def trace_status(rep: Report, imp: dict, prep: dict, cases: list) -> dict:
    """The trace verdict. Besides PASS, FAIL, PARTIAL and SKIP:
      PASS-STUBBED       every shape ran our code to the end or up to a stubbed call into a JUDGE_LIBRARIES
                         library (which exists only in the judge image); no ERROR. `stubbed` names the libraries.
      PARTIAL-EMULATION  prepare() hit an emulation limit. `limit` says where:
                         "prepare-self-test": prepare compared tensor values (torch.equal/allclose), which meta
                           tensors cannot do; precheck assumed the comparisons hold and traced kernel_fn on the
                           path that follows, which came out PASS or PASS-STUBBED (`stubbed`);
                         "prepare": prepare stopped at another emulation limit, so kernel_fn was not traced."""
    errs = [f for f in rep.findings if f.stage == "trace" and f.severity == "ERROR"]
    if not cases and not imp:
        return {"status": "SKIP", "why": "no reference.py/problem to generate inputs"}
    if errs:
        return {"status": "FAIL", "why": errs[0].message[:200] if len(errs) == 1 else
                f"{len(errs)} errors; first: {errs[0].message[:160]}"}
    if prep.get("emulation"):
        return {"status": "PARTIAL-EMULATION", "limit": "prepare",
                "why": f"prepare() stopped at an emulation limit at line {prep.get('line')} "
                       f"({str(prep.get('error'))[:140]}); kernel_fn was not traced"}
    if imp.get("emulation"):
        return {"status": "PARTIAL", "why": "import stopped at an emulation limit; initialization is unchecked"}
    reached = sum(c["status"] != "skipped" for c in cases)
    if not reached:
        return {"status": "PARTIAL", "why": f"0/{len(cases)} discovered shapes reached kernel_fn"}
    ok = sum(c["status"] == "ok" for c in cases)
    emu = [c for c in cases if c["status"] == "emulation"]
    stubs = {c.get("stub") for c in emu}
    stubbed = sorted(s for s in stubs if s)
    if emu and all(c["status"] in ("ok", "emulation") for c in cases) and stubs <= set(JUDGE_LIBRARIES):
        st = {"status": "PASS-STUBBED", "stubbed": stubbed,
              "why": f"{ok}/{len(cases)} shapes traced to the end, {len(emu)} up to a call into {', '.join(stubbed)} "
                     "(judge image only, stubbed here); no host syncs or shape failures seen"}
    elif emu:
        where = sorted({c.get("line") for c in emu})
        return {"status": "PARTIAL",
                "why": f"{len(emu)}/{len(cases)} shapes stopped at an emulation limit (line(s) {', '.join(map(str, where[:4]))}"
                       f"{'; stubbed: ' + ', '.join(stubbed) if stubbed else ''}); "
                       "kernel_fn past that point is unchecked"}
    elif ok != len(cases):
        return {"status": "PARTIAL", "why": f"{ok}/{len(cases)} shapes traced to the end; remaining shapes are unchecked"}
    else:
        st = {"status": "PASS", "why": f"{ok}/{len(cases)} shapes traced to the end, no host syncs or shape failures seen"}
    if prep.get("compared"):
        lines = ", ".join(map(str, prep["compared"][:6]))
        st = {"status": "PARTIAL-EMULATION", "limit": "prepare-self-test", "stubbed": st.get("stubbed", []),
              "why": f"prepare() compares tensor values at line(s) {lines}, which meta tensors cannot do; assumed they "
                     f"hold, then kernel_fn {st['status']}: {st['why']}"}
    return st


def _finish_triton(rep, res, sections, env):
    S = "triton"
    rows = res.get("triton", [])
    tt = ["-- triton (compiled for cuda sm_90a by triton " + str(env.get("triton")) + "; regs/spills from ptxas -v on its PTX)"]
    for e in res.get("triton_errors", []):
        rep.add(S, "ERROR", e.get("line"), "triton.compile", f"{e['kernel']} fails to compile/launch ({e.get('case')}): {e['error'][:400]}")
    if rows:
        groups = {}
        for r in rows:
            groups.setdefault(r["kernel"], []).append(r)
        tt.append(f"  {'kernel':26s} {'specs':>5s} {'regs':>9s} {'max smem':>9s} {'spills':>7s}  traced from")
        for name, rs in sorted(groups.items()):
            regs = [r["regs"] for r in rs if r.get("regs") is not None]
            spills = sum((r.get("spill_st") or 0) + (r.get("spill_ld") or 0) for r in rs)
            cases = sorted({c for r in rs for c in r.get("cases", [])})
            reg_s = f"{min(regs)}-{max(regs)}" if regs and min(regs) != max(regs) else (str(regs[0]) if regs else "?")
            tt.append(f"  {name[:26]:26s} {len(rs):5d} {reg_s:>9s} {max((r.get('shared') or 0) for r in rs):9d} {spills:7d}  "
                      f"{len(cases)} shape(s)/phase(s): {', '.join(cases[:3])[:70]}")
        tt.append("  (one row per specialization in --json output: constexprs, warps, stages, regs, spills, smem)")
        for r in rows:
            ce = {k: v for k, v in (r.get("constexprs") or {}).items() if k not in ("num_warps", "num_stages")}
            if r.get("spill_st") or r.get("spill_ld"):
                rep.add(S, "WARN", r.get("line"), "triton.spill",
                        f"{r['kernel']} {json.dumps(ce)[:80]} warps={r.get('num_warps')} spills "
                        f"{r.get('spill_st')}/{r.get('spill_ld')} B ({r.get('regs')} regs)")
            serial = [d for d in r.get("ptxas_diag", []) if d["code"] != "spill"]
            _ptxas_diag_findings(rep, S, r.get("line"), serial, {}, {}, f"{json.dumps(ce)[:80]} warps={r.get('num_warps')}")
    rep.details["triton_specializations"] = rows
    lines_of = res.get("triton_lines", {})
    for name in res.get("unlaunched_triton", []):
        rep.add(S, "WARN", lines_of.get(name, 0), "triton.unchecked",
                f"@triton.jit {name} was never launched in the trace, so its signature could not be inferred and it was not compiled")
    sections.append("\n".join(tt))
    errs = [f for f in rep.findings if f.stage == S and f.severity == "ERROR"]
    rep.stages[S] = {"status": "FAIL" if errs else ("PASS" if rows or not res.get("unlaunched_triton") else "PASS"),
                     "why": (errs[0].message[:200] if errs else
                             (f"{len(rows)} specialization(s) of {len({r['kernel'] for r in rows})} kernel(s) compiled" if rows
                              else "no Triton launches to compile")
                             + (f"; {len(res.get('unlaunched_triton', []))} kernel(s) never launched" if res.get("unlaunched_triton") else ""))}




def stage_status(rep: Report, stage: str):
    errs = [f for f in rep.findings if f.stage == stage and f.severity == "ERROR"]
    warns = [f for f in rep.findings if f.stage == stage and f.severity == "WARN"]
    if stage in rep.stages and rep.stages[stage].get("status") == "SKIP":
        return rep.stages[stage]
    st = rep.stages.setdefault(stage, {})
    if errs:
        st["status"] = "FAIL"
        st["why"] = errs[0].message if len(errs) == 1 else f"{len(errs)} errors; first: L{errs[0].line} {errs[0].message}"
    else:
        st.setdefault("status", "PASS")
        if not st.get("why"):
            st["why"] = f"{len(warns)} warning(s)" if warns else "clean"
    return st


def status_label(st: dict) -> str:
    """PASS-STUBBED -> "PASS (stubbed: sgl_kernel)"; PARTIAL-EMULATION -> "PARTIAL-EMULATION (prepare)"."""
    if st["status"] == "PASS-STUBBED":
        return f"PASS (stubbed: {', '.join(st.get('stubbed', []))})"
    if st["status"] == "PARTIAL-EMULATION":
        return f"PARTIAL-EMULATION ({st.get('limit')})"
    return st["status"]


def print_report(rep: Report, verbose=False):
    w = sys.stdout.write
    w(f"\nprecheck {rep.path}  (problem: {rep.problem or 'unknown'})\n\n")
    order = {"ERROR": 0, "WARN": 1, "INFO": 2}
    for stage in ("lint", "build", "trace", "triton"):
        fs = sorted((f for f in rep.findings if f.stage == stage), key=lambda f: (order[f.severity], f.line))
        if not verbose:
            fs = [f for f in fs if f.severity != "INFO"]
        if not fs:
            continue
        w(f"-- {stage} findings\n")
        for f in fs:
            loc = f"L{f.line}" if f.line else "  -"
            w(f"  {f.severity:5s} {loc:>6s}  [{f.rule}] {f.message}\n")
        w("\n")
    for section in rep.details.get("sections", []):
        w(section.rstrip() + "\n\n")
    if rep.details.get("container_tail"):
        w("-- container output (tail)\n" + "\n".join(rep.details["container_tail"]) + "\n\n")
    w("Summary\n")
    for stage in ("lint", "build", "trace", "triton"):
        st = stage_status(rep, stage) if stage in rep.stages or stage == "lint" else None
        if st:
            w(f"  {stage:7s} {status_label(st):7s} {st.get('why', '')}\n")
    n_info = sum(f.severity == "INFO" for f in rep.findings)
    if n_info and not verbose:
        w(f"  ({n_info} INFO findings hidden; --verbose shows them)\n")


def main(argv=None):
    ap = argparse.ArgumentParser(prog="precheck", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("submission", help="submission .py file (or the stage dir with --in-container)")
    ap.add_argument("--problem", choices=PROBLEMS, help="defaults to the file's `# okc: problem=` line")
    ap.add_argument("--scout", type=Path, default=None, help="optional external source tree for import inspection (or OKC_SCOUT)")
    ap.add_argument("--lint-only", action="store_true", help="stage 1 only (no Docker)")
    ap.add_argument("--no-trace", action="store_true", help="build stage only in Docker: skip the emulated prepare/kernel_fn trace")
    ap.add_argument("--quick", action="store_true", help="trace the scored shapes and a few nearby ones only")
    ap.add_argument("--case-timeout", type=int, default=120, help="seconds per traced kernel_fn call (default 120)")
    ap.add_argument("--json", action="store_true", help="print the report as JSON")
    ap.add_argument("--verbose", "-v", action="store_true", help="also show INFO findings")
    ap.add_argument("--rebuild-image", action="store_true")
    # 10g: entries now build extensions in parallel inside prepare(); only one container runs at a time (flock).
    ap.add_argument("--memory", default="10g", help="docker --memory limit for the container (default 10g)")
    ap.add_argument("--keep-stage", action="store_true", help="keep the staging dir (build logs, result.json)")
    ap.add_argument("--stage-root", default=None, help="where to create the staging dir (default: system temp)")
    ap.add_argument("--sass", metavar="REGEX", default=None,
                    help="after each build, cuobjdump -sass the kernels whose mangled or demangled name matches "
                         "into <stage>/sass/<kernel>.sass (keeps the stage dir)")
    ap.add_argument("--in-container", action="store_true", help=argparse.SUPPRESS)
    args = ap.parse_args(argv)
    if args.in_container:
        return container_main(Path(args.submission))

    sub = Path(args.submission).resolve()
    if not sub.is_file():
        ap.error(f"{sub} not found")
    mod = Module(sub)
    head = re.match(r"#\s*okc:\s*problem=(\S+)", mod.lines[0] if mod.lines else "")
    problem = args.problem or (head.group(1) if head and head.group(1) in PROBLEMS else None)
    rep = Report(path=str(sub), problem=problem)
    scout = args.scout or (Path(os.environ["OKC_SCOUT"]) if os.environ.get("OKC_SCOUT") else None)
    lint(mod, rep, problem, scout)
    if not scout or not scout.is_dir():
        reason = "no --scout or OKC_SCOUT path supplied" if scout is None else "configured scout path is not a directory"
        rep.add("lint", "INFO", 0, "imports.skipped", f"import inspection skipped: {reason}; lint is not full import validation")
    if args.lint_only:
        for s in ("build", "trace", "triton"):
            rep.stages[s] = {"status": "SKIP", "why": "--lint-only"}
    else:
        run_container(rep, sub, problem, args)
    for s in ("lint", "build", "trace", "triton"):
        if s in rep.stages or s == "lint":
            stage_status(rep, s)
    if args.json:
        out = asdict(rep)
        out["details"].pop("sections", None)
        print(json.dumps(out, indent=1, default=str))
    else:
        print_report(rep, args.verbose)
    return 1 if any(f.severity == "ERROR" for f in rep.findings) else 0


if __name__ == "__main__":
    sys.exit(main())
