class HostSync(RuntimeError):
    """Raised inside a traced kernel_fn at a host synchronization."""


class EmulationLimit(RuntimeError):
    """The emulated GPU cannot follow this path (stubbed library result, unsupported meta op)."""


class Trace:
    """Global trace state shared by the emulation hooks."""
    in_kernel = False
    case = None
    events: list = []
    hazards: list = []
    stub_calls: list = []
    sub_file = None
    compared: list = []  # submission lines whose tensor-value comparison outside kernel_fn was assumed to hold

    @classmethod
    def site(cls):
        """Innermost submission line on the current stack."""
        import traceback as tb
        for fr in reversed(tb.extract_stack()):
            if fr.filename == cls.sub_file:
                return fr.lineno
        return 0

    @classmethod
    def hazard(cls, kind, what):
        line = cls.site()
        cls.hazards.append({"kind": kind, "what": what, "line": line, "case": cls.case})
        return line


class Stub:
    """Stand-in for anything from a library the image has but this container doesn't (sglang, ...)."""

    def __init__(self, name):
        object.__setattr__(self, "_name", name)

    def __getattr__(self, attr):
        if attr.startswith("__") and attr.endswith("__"):
            raise AttributeError(attr)
        return Stub(f"{self._name}.{attr}")

    def __setattr__(self, k, v):
        pass

    def __call__(self, *a, **k):
        if Trace.in_kernel and "()" not in self._name:
            Trace.events.append(("lib", self._name))
        Trace.stub_calls.append(self._name)
        return Stub(f"{self._name}()")

    def __getitem__(self, k):
        return Stub(f"{self._name}[]")

    def __setitem__(self, k, v):
        pass

    def __iter__(self):
        return iter(())

    def __len__(self):
        return 0

    def __bool__(self):
        return True

    def __int__(self):
        return 1

    __index__ = __int__

    def __float__(self):
        return 1.0

    def __repr__(self):
        return f"<stub {self._name}>"

    def __mro_entries__(self, bases):
        return (object,)

    def __enter__(self):
        return self

    def __exit__(self, *a):
        return False

    def _op(self, *a):
        return self

    __add__ = __radd__ = __sub__ = __rsub__ = __mul__ = __rmul__ = __truediv__ = __rtruediv__ = _op
    __floordiv__ = __rfloordiv__ = __mod__ = __neg__ = __and__ = __or__ = __lt__ = __gt__ = __le__ = __ge__ = _op


def install_stub_importer(log, values=None):
    """Stub every STUB_PACKAGES library the image lacks; `values` gives real attributes to named stub modules."""
    import importlib.abc
    import importlib.machinery
    import importlib.util
    import types

    missing = set()
    for top in STUB_PACKAGES:
        try:
            if importlib.util.find_spec(top) is None:
                missing.add(top)
        except Exception:
            missing.add(top)

    class StubModule(types.ModuleType):
        def __getattr__(self, attr):
            if attr.startswith("__") and attr.endswith("__"):
                raise AttributeError(attr)
            return Stub(f"{self.__name__}.{attr}")

    class Finder(importlib.abc.MetaPathFinder, importlib.abc.Loader):
        def find_spec(self, fullname, path=None, target=None):
            if fullname.split(".")[0] in missing:
                return importlib.machinery.ModuleSpec(fullname, self, is_package=True)
            return None

        def create_module(self, spec):
            m = StubModule(spec.name)
            m.__path__ = []
            log.append(spec.name)
            return m

        def exec_module(self, module):
            module.__dict__.update((values or {}).get(module.__name__, {}))

    sys.meta_path.append(Finder())
    return missing


def install_gpu_emulation(torch, out):
    """Make torch believe one H200 exists: 'cuda' tensors become meta tensors and the CUDA
    runtime calls (streams, events, graphs, properties) become no-ops."""
    import contextlib
    import types
    from torch.overrides import TorchFunctionMode

    props = types.SimpleNamespace(**H200)
    cuda = torch.cuda

    class FakeStream:
        cuda_stream = 0
        device = torch.device("meta")

        def __init__(self, *a, **k):
            pass

        def wait_stream(self, *a):
            pass

        def wait_event(self, *a):
            pass

        def record_event(self, e=None):
            return e or FakeEvent()

        def synchronize(self):
            host_sync("Stream.synchronize()")

        def query(self):
            return True

        def __enter__(self):
            return self

        def __exit__(self, *a):
            return False

    class FakeEvent:
        def __init__(self, *a, **k):
            pass

        def record(self, *a):
            pass

        def wait(self, *a):
            pass

        def query(self):
            return True

        def synchronize(self):
            host_sync("Event.synchronize()")

        def elapsed_time(self, other):
            if Trace.in_kernel:
                Trace.hazard("timing", "Event.elapsed_time() in kernel_fn")
            return 0.01

    class FakeGraph:
        def __init__(self, *a, **k):
            pass

        def capture_begin(self, *a, **k):
            pass

        def capture_end(self):
            pass

        def replay(self):
            pass

        def reset(self):
            pass

        def pool(self):
            return (0, 0)

        def enable_debug_mode(self):
            pass

    def host_sync(what):
        if Trace.in_kernel:
            Trace.hazard("sync", what)
            raise HostSync(what)

    @contextlib.contextmanager
    def fake_graph(*a, **k):
        yield

    @contextlib.contextmanager
    def fake_stream_ctx(*a, **k):
        yield

    patches = {
        "is_available": lambda: True, "device_count": lambda: 1, "current_device": lambda: 0,
        "get_device_capability": lambda *a: (9, 0), "get_device_properties": lambda *a: props,
        "get_device_name": lambda *a: props.name, "synchronize": lambda *a: host_sync("torch.cuda.synchronize()"),
        "Stream": FakeStream, "ExternalStream": FakeStream, "current_stream": lambda *a: FakeStream(),
        "default_stream": lambda *a: FakeStream(), "stream": fake_stream_ctx, "Event": FakeEvent,
        "CUDAGraph": FakeGraph, "graph": fake_graph, "graph_pool_handle": lambda: (0, 0), "set_device": lambda *a: None,
        "empty_cache": lambda: None, "memory_allocated": lambda *a: 0, "max_memory_allocated": lambda *a: 0,
        "memory_reserved": lambda *a: 0, "reset_peak_memory_stats": lambda *a: None, "mem_get_info": lambda *a: (140 << 30, 141 << 30),
        "is_current_stream_capturing": lambda: False, "init": lambda: None, "is_initialized": lambda: True,
        "manual_seed": lambda *a: None, "manual_seed_all": lambda *a: None, "set_stream": lambda *a: None,
        "get_arch_list": lambda: ["sm_80", "sm_90", "sm_100", "sm_120"], "ipc_collect": lambda: None,
        "device": fake_stream_ctx, "_lazy_init": lambda: None,
    }
    for k, v in patches.items():
        setattr(cuda, k, v)
    torch.cuda.nvtx.range_push = lambda *a, **k: 0
    torch.cuda.nvtx.range_pop = lambda *a, **k: 0
    torch.cuda.nvtx.range = fake_stream_ctx

    real_gen = torch.Generator

    class Gen(real_gen):
        def __new__(cls, device="cpu"):
            dev = str(device)
            return real_gen.__new__(cls, device="cpu" if dev.startswith("cuda") or dev == "meta" else device)

    torch.Generator = Gen

    def is_cuda_dev(d):
        if isinstance(d, torch.device):
            return d.type == "cuda"
        if isinstance(d, int) and not isinstance(d, bool):
            return True
        return isinstance(d, str) and d.startswith("cuda")

    Tensor = torch.Tensor
    compare_methods = {torch.equal: "torch.equal", Tensor.equal: "Tensor.equal",
                       torch.allclose: "torch.allclose", Tensor.allclose: "Tensor.allclose"}
    sync_methods = {Tensor.item: "Tensor.item()", Tensor.tolist: "Tensor.tolist()", Tensor.cpu: "Tensor.cpu()",
                    Tensor.numpy: "Tensor.numpy()", Tensor.__bool__: "bool(tensor)", Tensor.__int__: "int(tensor)",
                    Tensor.__float__: "float(tensor)", Tensor.__index__: "tensor used as an index (int)"}
    value_shape = {torch.nonzero: "torch.nonzero", Tensor.nonzero: "Tensor.nonzero", torch.masked_select: "masked_select",
                   Tensor.masked_select: "masked_select", torch.unique: "torch.unique", Tensor.unique: "Tensor.unique",
                   torch.unique_consecutive: "unique_consecutive", torch.argwhere: "argwhere"}
    meta = torch.device("meta")

    class MetaCuda(TorchFunctionMode):
        def __torch_function__(self, func, types_, args=(), kwargs=None):
            kwargs = dict(kwargs or {})
            if func in compare_methods and any(isinstance(t, Tensor) and t.device.type == "meta" for t in args[:2]):
                # Meta tensors have no values. In kernel_fn the comparison is a host sync; elsewhere (prepare's
                # self-tests) assume it holds, so the trace follows the path a passing self-test takes.
                if Trace.in_kernel:
                    Trace.hazard("sync", compare_methods[func] + " in the timed path")
                    raise HostSync(compare_methods[func])
                Trace.compared.append(Trace.site())
                return True
            if func in sync_methods:
                t = args[0] if args else None
                if isinstance(t, Tensor) and t.device.type == "meta":
                    if Trace.in_kernel:
                        Trace.hazard("sync", sync_methods[func] + " in the timed path")
                        raise HostSync(sync_methods[func])
                    with torch._C.DisableTorchFunction():
                        if func is Tensor.cpu:
                            return torch.zeros(t.shape, dtype=t.dtype)
                        if func is Tensor.tolist:
                            return torch.zeros(t.shape, dtype=t.dtype).tolist()
                        if func is Tensor.numpy:
                            return torch.zeros(t.shape, dtype=t.dtype).numpy()
                    # Scalar values do not exist on meta tensors. Inventing one can either fail an intact
                    # canary or silently pass a broken self-test; stop without claiming either result.
                    raise EmulationLimit(f"{sync_methods[func]} needs tensor values; "
                                         "meta emulation cannot validate scalar readback")
            if func in value_shape and Trace.in_kernel:
                Trace.hazard("value-shape", value_shape[func] + " (output shape depends on values)")
                raise HostSync(value_shape[func])
            if func in (Tensor.__getitem__, Tensor.__setitem__) and Trace.in_kernel and len(args) > 1:
                idx = args[1] if isinstance(args[1], tuple) else (args[1],)
                if any(isinstance(i, Tensor) and i.dtype == torch.bool for i in idx):
                    Trace.hazard("value-shape", "boolean-mask indexing (value-dependent shape)")
                    raise HostSync("boolean mask index")
            if func is Tensor.cuda:
                t = args[0]
                if Trace.in_kernel and t.device.type == "cpu":
                    Trace.hazard("h2d", "Tensor.cuda() of a host tensor in the timed path")
                return t.to(meta)
            if "device" in kwargs and is_cuda_dev(kwargs["device"]):
                kwargs["device"] = meta
                if func in (torch.tensor, torch.as_tensor) and Trace.in_kernel:
                    Trace.hazard("h2d", f"{func.__name__}(..., device='cuda') in the timed path (host-to-device copy)")
            if func in (Tensor.to,):
                a = list(args)
                for i, x in enumerate(a[1:], 1):
                    if is_cuda_dev(x):
                        a[i] = meta
                if Trace.in_kernel and isinstance(a[0], Tensor) and a[0].device.type == "cpu" and \
                        (meta in a[1:] or kwargs.get("device") == meta):
                    Trace.hazard("h2d", "Tensor.to('cuda') of a host tensor in the timed path")
                args = tuple(a)
            if kwargs.get("pin_memory"):
                kwargs["pin_memory"] = False
            if "generator" in kwargs and (kwargs.get("device") == meta or any(
                    isinstance(x, Tensor) and x.device.type == "meta" for x in args)):
                kwargs.pop("generator")
            if func is Tensor.pin_memory:
                return args[0]
            if func is Tensor.record_stream:
                return None
            try:
                return func(*args, **kwargs)
            except NotImplementedError as e:
                raise EmulationLimit(f"meta tensors cannot run {getattr(func, '__name__', func)}: {str(e)[:200]}") from e

    return MetaCuda


